{% extends 'layout.html.twig' %}
{% import 'partials/icons.html.twig' as icons %}

{% block title %}Versiones - Atilio Automotores{% endblock %}
{% block page_title %}Versiones{% endblock %}
{% block page_subtitle %}
    <p class="text-xs text-muted">{{ total }} version{{ total == 1 ? '' : 'es' }}</p>
{% endblock %}

{% block page_actions %}
    {% if is_granted('catalogo.crear') %}
        <button type="button" class="btn-primary btn-sm"
                data-action="remote-dialog#open"
                data-dialog-url="{{ path('app_versiones_new') }}"
                data-dialog-title="Nueva version">
            {{ icons.icon('plus', 'size-4') }}<span class="hidden sm:inline">Nueva version</span>
        </button>
    {% endif %}
{% endblock %}

{% block body %}
<div>
    {# ---- Estado del catalogo ---- #}
    <div class="mb-5 grid grid-cols-3 gap-3">
        <a href="{{ path('app_versiones_index') }}" data-turbo="false"
           class="card p-4 transition hover:shadow-md {{ uso is null ? 'ring-1 ring-accent/30' : '' }}">
            <p class="field-label">Cargadas</p>
            <p class="mt-1.5 text-2xl font-semibold tracking-tight">{{ resumen.total }}</p>
        </a>
        <a href="{{ path('app_versiones_index', {'uso': 'sin-uso'}) }}" data-turbo="false"
           class="card p-4 transition hover:shadow-md {{ uso == 'sin-uso' ? 'ring-1 ring-accent/30' : '' }}">
            <p class="field-label">Sin ningun vehiculo</p>
            <p class="mt-1.5 text-2xl font-semibold tracking-tight text-amber-600 dark:text-amber-400">{{ resumen.sinUso }}</p>
        </a>
        <a href="{{ path('app_versiones_index', {'uso': 'sin-nombre'}) }}" data-turbo="false"
           class="card p-4 transition hover:shadow-md {{ uso == 'sin-nombre' ? 'ring-1 ring-accent/30' : '' }}">
            <p class="field-label">Sin nombre</p>
            <p class="mt-1.5 text-2xl font-semibold tracking-tight text-amber-600 dark:text-amber-400">{{ resumen.sinNombre }}</p>
        </a>
    </div>

    <turbo-frame id="versiones" data-turbo-action="advance" class="block">
        <div class="card overflow-hidden">
            <form method="get" action="{{ path('app_versiones_index') }}"
                  data-controller="filter-form"
                  class="flex flex-wrap items-end gap-3 border-b border-line bg-surface-2 p-4">
                <div class="relative min-w-64 flex-1">
                    <span class="pointer-events-none absolute inset-y-0 left-3 flex items-center text-subtle">
                        {{ icons.icon('search', 'size-4') }}
                    </span>
                    <input type="search" name="q" value="{{ q }}" autocomplete="off"
                           placeholder="Buscar version, modelo o marca" class="input pl-9">
                </div>
                <select name="uso" class="input w-52">
                    <option value="">Todas</option>
                    <option value="sin-uso" {{ uso == 'sin-uso' ? 'selected' }}>Sin ningun vehiculo</option>
                    <option value="sin-nombre" {{ uso == 'sin-nombre' ? 'selected' }}>Sin nombre</option>
                </select>
                <button type="submit" class="btn-primary">{{ icons.icon('search', 'size-4') }} Buscar</button>
                {% if q or uso %}
                    <a href="{{ path('app_versiones_index') }}" class="btn-ghost btn-sm">{{ icons.icon('x', 'size-4') }} Limpiar</a>
                {% endif %}
            </form>

            <div class="table-wrap">
                <table class="table">
                    <thead>
                        <tr>
                            <th>Marca y modelo</th>
                            <th>Version</th>
                            <th>Caracteristicas</th>
                            <th class="text-right">Vehiculos</th>
                            <th class="text-right">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                    {% for fila in filas %}
                        {% set version = fila[0] %}
                        <tr>
                            <td>
                                <span class="text-muted">{{ version.modelo.marca.name }}</span>
                                <span class="font-medium">{{ version.modelo.name }}</span>
                            </td>
                            <td>
                                {% if version.name %}
                                    {{ version.name }}
                                {% else %}
                                    <span class="badge-amber">sin nombre</span>
                                {% endif %}
                            </td>
                            <td class="max-w-xs truncate text-muted" title="{{ version.characteristics }}">
                                {{ version.characteristics|default('-') }}
                            </td>
                            <td class="text-right">
                                {% if fila.vehiculos > 0 %}
                                    <span class="badge-accent">{{ fila.vehiculos }}</span>
                                {% else %}
                                    <span class="text-xs text-subtle">sin uso</span>
                                {% endif %}
                            </td>
                            <td>
                                <div class="flex items-center justify-end gap-1">
                                    {% if is_granted('catalogo.editar') %}
                                        <button type="button" class="btn-ghost btn-sm" title="Editar"
                                                data-action="remote-dialog#open"
                                                data-dialog-url="{{ path('app_versiones_edit', {'id': version.id}) }}"
                                                data-dialog-title="Editar version">
                                            {{ icons.icon('pencil', 'size-4') }}
                                        </button>
                                    {% endif %}
                                </div>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="5" class="py-16 text-center">
                                <div class="mx-auto flex max-w-sm flex-col items-center gap-2 text-subtle">
                                    {{ icons.icon('tag', 'size-8') }}
                                    <p class="text-sm font-medium text-muted">No se encontraron versiones</p>
                                </div>
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>

            {% if total > 25 %}
                <div class="flex flex-wrap items-center justify-between gap-3 border-t border-line bg-surface-2 px-4 py-3">
                    <p class="text-xs text-muted">
                        Mostrando <span class="font-medium text-fg">{{ (currentPage - 1) * 25 + 1 }}-{{ min(currentPage * 25, total) }}</span>
                        de <span class="font-medium text-fg">{{ total }}</span>
                    </p>
                    <div class="flex items-center gap-1">
                        <a href="{{ path('app_versiones_index', app.request.query.all|merge({'page': currentPage - 1})) }}"
                           class="btn-ghost btn-sm {{ currentPage == 1 ? 'pointer-events-none opacity-40' : '' }}">
                            {{ icons.icon('chevron-left', 'size-4') }}
                        </a>
                        {% for p in 1..totalPages %}
                            {% if p == 1 or p == totalPages or (p >= currentPage - 1 and p <= currentPage + 1) %}
                                <a href="{{ path('app_versiones_index', app.request.query.all|merge({'page': p})) }}"
                                   class="btn-sm {{ p == currentPage ? 'btn-primary' : 'btn-ghost' }} min-w-8">{{ p }}</a>
                            {% elseif p == 2 or p == totalPages - 1 %}
                                <span class="px-1 text-subtle">...</span>
                            {% endif %}
                        {% endfor %}
                        <a href="{{ path('app_versiones_index', app.request.query.all|merge({'page': currentPage + 1})) }}"
                           class="btn-ghost btn-sm {{ currentPage == totalPages ? 'pointer-events-none opacity-40' : '' }}">
                            {{ icons.icon('chevron-right', 'size-4') }}
                        </a>
                    </div>
                </div>
            {% endif %}
        </div>
    </turbo-frame>

    <dialog data-remote-dialog-target="dialog" class="modal max-w-md">
        <div class="modal-header flex items-center justify-between">
            <h3 class="font-semibold" data-remote-dialog-target="title"></h3>
            <button type="button" data-action="remote-dialog#close" class="btn-ghost btn-icon">
                {{ icons.icon('x', 'size-4') }}
            </button>
        </div>
        <div data-remote-dialog-target="content"></div>
    </dialog>
</div>
{% endblock %}
