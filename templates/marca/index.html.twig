{% extends 'layout.html.twig' %}
{% import 'partials/icons.html.twig' as icons %}

{% block title %}Marcas - Atilio Automotores{% endblock %}
{% block page_title %}Marcas{% endblock %}
{% block page_subtitle %}
    <p class="text-xs text-muted">{{ filas|length }} marca{{ filas|length == 1 ? '' : 's' }}</p>
{% endblock %}

{% block page_actions %}
    {% if is_granted('catalogo.crear') %}
        <button type="button" class="btn-primary btn-sm"
                data-action="remote-dialog#open"
                data-dialog-url="{{ path('app_marca_new') }}"
                data-dialog-title="Nueva marca">
            {{ icons.icon('plus', 'size-4') }}<span class="hidden sm:inline">Nueva marca</span>
        </button>
    {% endif %}
{% endblock %}

{% block body %}
<div>
    <turbo-frame id="marcas" data-turbo-action="advance" class="block">
        <div class="card overflow-hidden">
            <form method="get" action="{{ path('app_marca_index') }}"
                  data-controller="filter-form"
                  class="flex flex-wrap items-end gap-3 border-b border-line bg-surface-2 p-4">
                <div class="relative min-w-64 flex-1">
                    <span class="pointer-events-none absolute inset-y-0 left-3 flex items-center text-subtle">
                        {{ icons.icon('search', 'size-4') }}
                    </span>
                    <input type="search" name="q" value="{{ q }}" autocomplete="off"
                           placeholder="Buscar marca" class="input pl-9">
                </div>
                <button type="submit" class="btn-primary">{{ icons.icon('search', 'size-4') }} Buscar</button>
                {% if q %}
                    <a href="{{ path('app_marca_index') }}" class="btn-ghost btn-sm">{{ icons.icon('x', 'size-4') }} Limpiar</a>
                {% endif %}
            </form>

            <div class="table-wrap">
                <table class="table">
                    <thead>
                        <tr>
                            <th>Marca</th>
                            <th class="text-right">Modelos</th>
                            <th class="text-right">Vehiculos cargados</th>
                            <th class="text-right">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                    {% for fila in filas %}
                        {% set marca = fila[0] %}
                        <tr>
                            <td class="font-medium">{{ marca.name }}</td>
                            <td class="mono text-right text-muted">{{ fila.modelos }}</td>
                            <td class="text-right">
                                {% if fila.vehiculos > 0 %}
                                    <a href="{{ path('app_vehiculos_index', {'marca': marca.id}) }}"
                                       class="badge-accent" data-turbo="false">{{ fila.vehiculos }}</a>
                                {% else %}
                                    <span class="text-xs text-subtle">sin uso</span>
                                {% endif %}
                            </td>
                            <td>
                                <div class="flex items-center justify-end gap-1">
                                    <a href="{{ path('app_modelos_index', {'marca': marca.id}) }}" class="btn-ghost btn-sm"
                                       data-turbo="false" title="Ver modelos">{{ icons.icon('tag', 'size-4') }}</a>
                                    {% if is_granted('catalogo.editar') %}
                                        <button type="button" class="btn-ghost btn-sm" title="Editar"
                                                data-action="remote-dialog#open"
                                                data-dialog-url="{{ path('app_marca_edit', {'id': marca.id}) }}"
                                                data-dialog-title="Editar marca">
                                            {{ icons.icon('pencil', 'size-4') }}
                                        </button>
                                    {% endif %}
                                </div>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="4" class="py-16 text-center">
                                <div class="mx-auto flex max-w-sm flex-col items-center gap-2 text-subtle">
                                    {{ icons.icon('tag', 'size-8') }}
                                    <p class="text-sm font-medium text-muted">No se encontraron marcas</p>
                                </div>
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </turbo-frame>

    <dialog data-remote-dialog-target="dialog" class="modal max-w-sm">
        <div class="modal-header flex items-center justify-between">
            <h3 class="font-semibold" data-remote-dialog-target="title"></h3>
            <button type="button" data-action="remote-dialog#close" class="btn-ghost btn-icon">
                {{ icons.icon('x', 'size-4') }}
            </button>
        </div>
        <div data-remote-dialog-target="content"></div>
    </dialog>
</div>
{% endblock %}
