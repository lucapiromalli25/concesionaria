{% form_theme form 'form/tailwind_theme.html.twig' %}

{{ form_start(form, {'action': path('app_plan_de_pagos_modificar', {'id': venta.id})}) }}
    {% if not form.vars.valid %}
        <div class="mx-5 mt-4 rounded-lg border border-red-200 bg-red-50 px-3 py-2 text-xs text-red-700 dark:border-red-400/25 dark:bg-red-500/10 dark:text-red-300">
            {{ form_errors(form) }}
            {% if form.vars.errors|length == 0 %}No se pudo guardar. Revisa los campos marcados.{% endif %}
        </div>
    {% endif %}
    <div class="space-y-4 px-5 py-4">
        <div class="rounded-lg border border-line bg-surface-2 px-3 py-2 text-sm">
            <p class="text-muted">Plan actual</p>
            <p class="mt-0.5 font-medium tabular-nums">
                {{ venta.numberOfInstallments }} cuotas de
                {{ venta.saleCurrency|default('ARS') == 'USD' ? 'USD' : '$' }}
                {{ (venta.finalSalePrice / venta.numberOfInstallments)|number_format(2, ',', '.') }}
            </p>
        </div>

        {{ form_row(form.numberOfInstallments, {'attr': {'inputmode': 'numeric', 'min': 1}}) }}

        <p class="hint">
            Se borran las cuotas actuales y se generan de nuevo en partes iguales, con vencimiento
            el dia 1 de cada mes.
        </p>
    </div>

    <div class="modal-footer">
        <button type="button" data-action="remote-dialog#close" class="btn-secondary btn-sm">Cancelar</button>
        <button type="submit" class="btn-primary btn-sm">Regenerar plan</button>
    </div>
{{ form_end(form) }}
