{% extends 'layout.html.twig' %}
{% import 'partials/icons.html.twig' as icons %}
{% import 'partials/format.html.twig' as fmt %}

{% set moneda = venta.saleCurrency|default('ARS') %}

{% block title %}Venta registrada - Atilio Automotores{% endblock %}
{% block page_title %}Venta registrada{% endblock %}

{% block body %}
<div class="mx-auto max-w-lg">
    <div class="card p-6 text-center">
        <div class="mx-auto flex size-12 items-center justify-center rounded-full bg-emerald-50 text-emerald-600 dark:bg-emerald-500/15 dark:text-emerald-400">
            {{ icons.icon('check', 'size-6') }}
        </div>
        <h2 class="mt-4 text-lg font-semibold">Venta {{ venta.receiptNumber }}</h2>
        <p class="mt-1 text-sm text-muted">
            {{ venta.vehiculo.version.modelo.marca.name }} {{ venta.vehiculo.version.modelo.name }}
            vendido a {{ venta.cliente.firstName }} {{ venta.cliente.lastName }}.
        </p>

        <dl class="mt-5 grid grid-cols-2 gap-4 border-y border-line py-4 text-left">
            <div>
                <dt class="field-label">Precio</dt>
                <dd class="field-value">{{ fmt.money(venta.finalSalePrice, moneda, 0) }}</dd>
            </div>
            <div>
                <dt class="field-label">Forma de pago</dt>
                <dd class="field-value">
                    {{ venta.paymentMethod }}
                    {% if venta.cuotas|length %}<span class="text-muted">({{ venta.cuotas|length }} cuotas)</span>{% endif %}
                </dd>
            </div>
        </dl>

        <div class="mt-5 flex flex-col gap-2 sm:flex-row">
            <a href="{{ path('app_ventas_receipt', {'id': venta.id}) }}" target="_blank" class="btn-primary flex-1">
                {{ icons.icon('document', 'size-4') }} Descargar recibo
            </a>
            <a href="{{ path('app_ventas_show', {'id': venta.id}) }}" class="btn-secondary flex-1">Ver la venta</a>
        </div>
    </div>
</div>
{% endblock %}
