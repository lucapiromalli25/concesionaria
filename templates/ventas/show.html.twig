{% extends 'layout.html.twig' %}
{% import 'partials/icons.html.twig' as icons %}
{% import 'partials/format.html.twig' as fmt %}

{% set moneda = venta.saleCurrency|default('ARS') %}
{% set cuotas = venta.cuotas|sort((a, b) => a.installmentNumber <=> b.installmentNumber) %}
{% set pagadas = venta.cuotas|filter(c => c.status == 'Pagada')|length %}

{% block title %}Venta {{ venta.receiptNumber|default('#' ~ venta.id) }} - Atilio Automotores{% endblock %}
{% block page_title %}Venta {{ venta.receiptNumber|default('#' ~ venta.id) }}{% endblock %}
{% block page_subtitle %}
    <p class="text-xs text-muted">
        {{ venta.saleDate|date('d/m/Y') }} - {{ venta.cliente.firstName }} {{ venta.cliente.lastName }}
    </p>
{% endblock %}

{% block page_actions %}
    <a href="{{ path('app_ventas_index') }}" class="btn-secondary btn-sm">Volver</a>
    {% if venta.receiptNumber %}
        <a href="{{ path('app_ventas_receipt', {'id': venta.id}) }}" target="_blank" class="btn-secondary btn-sm">
            {{ icons.icon('document', 'size-4') }} Recibo
        </a>
    {% endif %}
{% endblock %}

{% block body %}
<div data-controller="confirm-action">
    <div class="grid gap-5 lg:grid-cols-[minmax(0,1fr)_340px]">

        {# ================= Columna principal ================= #}
        <div class="space-y-5">

            {# ---- Resumen ---- #}
            <section class="card p-5">
                <div class="flex flex-wrap items-center gap-x-8 gap-y-4">
                    <div>
                        <p class="field-label">Precio de venta</p>
                        <p class="mt-1 text-xl font-semibold">{{ fmt.money(venta.finalSalePrice, moneda, 0) }}</p>
                    </div>
                    {% if cuotas|length %}
                        <div>
                            <p class="field-label">Cobrado</p>
                            <p class="mt-1 text-xl font-semibold text-emerald-600 dark:text-emerald-400">
                                {{ fmt.money(venta.getTotalPaid(), moneda, 0) }}
                            </p>
                        </div>
                        <div>
                            <p class="field-label">Saldo</p>
                            <p class="mt-1 text-xl font-semibold text-red-600 dark:text-red-400">
                                {{ fmt.money(venta.getPendingBalance(), moneda, 0) }}
                            </p>
                        </div>
                        <div class="ml-auto text-right">
                            <p class="field-label">Cuotas</p>
                            <p class="mt-1 text-sm font-medium">{{ pagadas }} de {{ cuotas|length }} pagas</p>
                            <div class="mt-1.5 h-1.5 w-32 overflow-hidden rounded-full" style="background-color: var(--app-line)">
                                <div class="h-full rounded-full bg-emerald-500"
                                     style="width: {{ cuotas|length ? (pagadas / cuotas|length * 100)|round : 0 }}%"></div>
                            </div>
                        </div>
                    {% else %}
                        <div>
                            <p class="field-label">Forma de pago</p>
                            <p class="mt-1 text-sm font-medium">{{ venta.paymentMethod|default('-') }}</p>
                        </div>
                    {% endif %}
                </div>
            </section>

            {# ---- Plan de pagos ---- #}
            {% if cuotas|length %}
                <section class="card overflow-hidden">
                    <div class="flex items-center justify-between gap-3 border-b border-line px-5 py-3">
                        <div>
                            <h2 class="text-sm font-semibold">Plan de pagos</h2>
                            <p class="hint mt-0.5">{{ venta.paymentMethod }} en {{ cuotas|length }} cuotas</p>
                        </div>
                        {% if not venta.hasPayments() and (is_granted('planes_pago.modificar')) %}
                            <button type="button" class="btn-secondary btn-sm"
                                    data-action="remote-dialog#open"
                                    data-dialog-url="{{ path('app_plan_de_pagos_modificar', {'id': venta.id}) }}"
                                    data-dialog-title="Modificar plan de pagos">
                                Modificar plan
                            </button>
                        {% endif %}
                    </div>
                    <div class="table-wrap">
                        <table class="table">
                            <thead>
                                <tr>
                                    <th>Cuota</th>
                                    <th>Vence</th>
                                    <th class="text-right">Monto</th>
                                    <th class="text-right">Pagado</th>
                                    <th>Estado</th>
                                    <th>Fecha de pago</th>
                                    <th class="text-right">Acciones</th>
                                </tr>
                            </thead>
                            <tbody>
                            {% for cuota in cuotas %}
                                <tr>
                                    <td class="font-medium">{{ cuota.installmentNumber }}</td>
                                    <td class="mono">{{ cuota.dueDate|date('d/m/Y') }}</td>
                                    <td class="text-right">{{ fmt.money(cuota.amount, moneda) }}</td>
                                    <td class="text-right">
                                        {% if cuota.paidAmount %}
                                            {{ fmt.money(cuota.paidAmount, cuota.paidCurrency|default(moneda)) }}
                                        {% else %}
                                            <span class="text-subtle">-</span>
                                        {% endif %}
                                    </td>
                                    <td>{{ fmt.estadoCuota(cuota) }}</td>
                                    <td class="mono text-muted">{{ cuota.paymentDate ? cuota.paymentDate|date('d/m/Y') : '-' }}</td>
                                    <td>
                                        <div class="flex items-center justify-end gap-1">
                                            {% if cuota.status == 'Pendiente' %}
                                                <button type="button" class="btn-primary btn-sm"
                                                        data-action="remote-dialog#open"
                                                        data-dialog-url="{{ path('app_cuotas_register_payment', {'id': cuota.id}) }}"
                                                        data-dialog-title="Cobrar cuota {{ cuota.installmentNumber }}">
                                                    Cobrar
                                                </button>
                                            {% else %}
                                                {% if cuota.receiptNumber %}
                                                    <a href="{{ path('app_cuotas_receipt', {'id': cuota.id}) }}" target="_blank"
                                                       title="Recibo del pago" class="btn-ghost btn-sm">{{ icons.icon('document', 'size-4') }}</a>
                                                {% endif %}
                                                {% if cuota.receiptName %}
                                                    <a href="{{ vich_uploader_asset(cuota, 'receiptFile') }}" target="_blank"
                                                       title="Comprobante del cliente" class="btn-ghost btn-sm">{{ icons.icon('eye', 'size-4') }}</a>
                                                {% endif %}
                                                <button type="button" class="btn-ghost btn-sm text-red-600 dark:text-red-400"
                                                        title="Anular el pago"
                                                        data-action="confirm-action#ask"
                                                        data-confirm-url="{{ path('app_cuotas_cancel_payment', {'id': cuota.id}) }}"
                                                        data-confirm-token="{{ csrf_token('cancel-payment' ~ cuota.id) }}"
                                                        data-confirm-label="Anular pago"
                                                        data-confirm-message="La cuota vuelve a quedar pendiente y se borra el comprobante subido.">
                                                    {{ icons.icon('x', 'size-4') }}
                                                </button>
                                            {% endif %}
                                        </div>
                                    </td>
                                </tr>
                            {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </section>
            {% endif %}

            {# ---- Observaciones ---- #}
            {% if venta.observations %}
                <section class="card p-5">
                    <h2 class="section-title mb-3">Observaciones</h2>
                    <p class="text-sm whitespace-pre-line">{{ venta.observations }}</p>
                </section>
            {% endif %}
        </div>

        {# ================= Columna lateral ================= #}
        <div class="space-y-5">

            {# ---- Vehiculo ---- #}
            <section class="card overflow-hidden">
                {% if venta.vehiculo.imagenesVehiculos is not empty %}
                    <img src="{{ vich_uploader_asset(venta.vehiculo.imagenesVehiculos|first, 'imageFile') }}" alt=""
                         class="aspect-video w-full bg-surface-2 object-cover">
                {% endif %}
                <div class="p-5">
                    <h2 class="section-title mb-3">Vehiculo</h2>
                    <a href="{{ path('app_vehiculos_show', {'id': venta.vehiculo.id}) }}"
                       class="text-base font-semibold hover:text-accent-text">
                        {{ venta.vehiculo.version.modelo.marca.name }} {{ venta.vehiculo.version.modelo.name }}
                    </a>
                    <div class="mt-3 flex items-center gap-3">
                        {% if venta.vehiculo.plateNumber %}<span class="plate">{{ venta.vehiculo.plateNumber }}</span>{% endif %}
                        <span class="mono text-sm text-muted">{{ venta.vehiculo.anio }}</span>
                    </div>
                </div>
            </section>

            {# ---- Datos ---- #}
            <section class="card p-5">
                <h2 class="section-title mb-4">Operacion</h2>
                <dl class="space-y-3">
                    <div class="flex items-baseline justify-between gap-3">
                        <dt class="field-label">Cliente</dt>
                        <dd class="text-right text-sm font-medium">
                            {{ venta.cliente.firstName }} {{ venta.cliente.lastName }}
                            <span class="mono block text-xs text-subtle">DNI {{ venta.cliente.documentNumber }}</span>
                        </dd>
                    </div>
                    {% if venta.cliente.phone %}
                        <div class="flex items-baseline justify-between gap-3">
                            <dt class="field-label">Telefono</dt>
                            <dd class="mono text-sm">{{ venta.cliente.phone }}</dd>
                        </div>
                    {% endif %}
                    <div class="flex items-baseline justify-between gap-3">
                        <dt class="field-label">Vendedor</dt>
                        <dd class="text-sm">{{ venta.vendedor ? venta.vendedor.completeName : '-' }}</dd>
                    </div>
                    <div class="flex items-baseline justify-between gap-3">
                        <dt class="field-label">Fecha</dt>
                        <dd class="mono text-sm">{{ venta.saleDate|date('d/m/Y') }}</dd>
                    </div>
                    <div class="flex items-baseline justify-between gap-3">
                        <dt class="field-label">Forma de pago</dt>
                        <dd class="text-sm">{{ venta.paymentMethod|default('-') }}</dd>
                    </div>
                </dl>

                {% if venta.saleDocumentName and is_granted('ventas.ver_documentos') %}
                    <a href="{{ vich_uploader_asset(venta, 'saleDocumentFile') }}" target="_blank" class="btn-secondary btn-sm mt-4 w-full">
                        {{ icons.icon('document', 'size-4') }} Boleto de venta
                    </a>
                {% endif %}
            </section>

            {# ---- Zona peligrosa ---- #}
            {% if not venta.hasPayments() and is_granted('ventas.eliminar') %}
                <section class="card p-5">
                    <h2 class="section-title mb-2">Anular</h2>
                    <p class="hint mb-3">
                        Se borra la venta con sus cuotas y el vehiculo vuelve a stock. Solo se puede mientras
                        no haya cuotas cobradas.
                    </p>
                    <button type="button" class="btn-danger btn-sm w-full"
                            data-action="confirm-action#ask"
                            data-confirm-url="{{ path('app_ventas_delete', {'id': venta.id}) }}"
                            data-confirm-token="{{ csrf_token('delete' ~ venta.id) }}"
                            data-confirm-label="Eliminar venta"
                            data-confirm-message="Se elimina la venta {{ venta.receiptNumber }} y sus cuotas. El vehiculo vuelve a estar En Stock.">
                        Eliminar venta
                    </button>
                </section>
            {% endif %}
        </div>
    </div>

    {# ---- Dialogo generico para formularios remotos ---- #}
    <dialog data-remote-dialog-target="dialog" class="modal max-w-md">
        <div class="modal-header flex items-center justify-between">
            <h3 class="font-semibold" data-remote-dialog-target="title"></h3>
            <button type="button" data-action="remote-dialog#close" class="btn-ghost btn-icon">
                {{ icons.icon('x', 'size-4') }}
            </button>
        </div>
        <div data-remote-dialog-target="content"></div>
    </dialog>

    {# ---- Dialogo de confirmacion ---- #}
    <dialog data-confirm-action-target="dialog" class="modal max-w-sm">
        <div class="px-5 py-4">
            <h3 class="font-semibold">Confirmar</h3>
            <p class="mt-1.5 text-sm text-muted" data-confirm-action-target="message"></p>
        </div>
        <div class="modal-footer">
            <button type="button" data-action="confirm-action#close" class="btn-secondary btn-sm">Cancelar</button>
            <button type="button" data-action="confirm-action#confirm" data-confirm-action-target="submit" class="btn-danger btn-sm"></button>
        </div>
    </dialog>
</div>
{% endblock %}
