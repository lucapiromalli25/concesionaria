{% extends 'layout.html.twig' %}
{% form_theme form 'form/tailwind_theme.html.twig' %}
{% import 'partials/icons.html.twig' as icons %}
{% import 'partials/format.html.twig' as fmt %}

{% block title %}Registrar venta - Atilio Automotores{% endblock %}
{% block page_title %}Registrar venta{% endblock %}
{% block page_subtitle %}
    <p class="text-xs text-muted">
        {{ vehiculo.version.modelo.marca.name }} {{ vehiculo.version.modelo.name }}{% if vehiculo.plateNumber %} - {{ vehiculo.plateNumber }}{% endif %}
    </p>
{% endblock %}

{% block body %}
<div data-controller="quick-create" data-action="combobox:create->quick-create#open">
    <div class="grid gap-5 lg:grid-cols-[minmax(0,1fr)_320px]">

        {# ================= Formulario ================= #}
        <div data-controller="installments"
             data-installments-preview-url-value="{{ path('app_ventas_plan_preview') }}">

            <form name="venta" method="post" action="{{ path('app_ventas_new', {'id': vehiculo.id}) }}"
                  enctype="multipart/form-data" novalidate class="space-y-5">

                {% if not form.vars.valid %}
                    <div class="flex items-start gap-3 rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800 dark:border-red-400/25 dark:bg-red-500/10 dark:text-red-300">
                        {{ icons.icon('alert', 'size-5 shrink-0') }}
                        <span>Hay campos con errores. Revisalos abajo.</span>
                    </div>
                {% endif %}

                {# ---- Datos de la venta ---- #}
                <section class="card p-5">
                    <h2 class="section-title mb-4">Datos de la venta</h2>

                    <div class="mb-4">{{ form_row(form.cliente) }}</div>

                    <div class="grid gap-4 sm:grid-cols-3">
                        {{ form_row(form.sale_date, {'attr': {'data-installments-target': 'fecha'}}) }}
                        {{ form_row(form.saleCurrency, {'attr': {
                            'data-installments-target': 'moneda',
                            'data-action': 'installments#recalcular'
                        }}) }}
                        {{ form_row(form.final_sale_price, {'attr': {
                            'data-installments-target': 'precio',
                            'data-action': 'input->installments#recalcular',
                            'inputmode': 'decimal'
                        }}) }}
                    </div>

                    <div class="mt-4">
                        {{ form_row(form.payment_method, {'attr': {
                            'data-installments-target': 'metodo',
                            'data-action': 'installments#toggle'
                        }}) }}
                    </div>
                </section>

                {# ---- Plan de cuotas ---- #}
                <section class="card hidden p-5" data-installments-target="section">
                    <div class="mb-4 flex flex-wrap items-end justify-between gap-3">
                        <div>
                            <h2 class="section-title">Plan de cuotas</h2>
                            <p class="hint mt-0.5">Genera el plan y ajusta las filas que necesites.</p>
                        </div>
                        <div class="flex items-end gap-2">
                            <div class="w-28">
                                {{ form_row(form.numberOfInstallments, {'attr': {
                                    'data-installments-target': 'count',
                                    'inputmode': 'numeric', 'min': 1, 'placeholder': '12'
                                }}) }}
                            </div>
                            <button type="button" data-action="installments#generar" class="btn-secondary btn-sm mb-[1px]">
                                Generar
                            </button>
                        </div>
                    </div>

                    <div class="mb-3 flex flex-wrap items-center justify-between gap-2 rounded-lg border border-line bg-surface-2 px-3 py-2">
                        <span class="text-xs text-muted">
                            Suma de cuotas:
                            <span data-installments-target="suma" class="font-semibold tabular-nums text-fg">$ 0,00</span>
                        </span>
                        <span data-installments-target="diferencia" class="text-xs"></span>
                    </div>

                    <div class="space-y-2" data-installments-target="editor"></div>

                    <button type="button" data-action="installments#agregar" class="btn-secondary btn-sm mt-3">
                        {{ icons.icon('plus', 'size-4') }} Agregar cuota
                    </button>

                    <input type="hidden" name="installments_data" data-installments-target="hidden">
                </section>

                {# ---- Documentacion ---- #}
                <section class="card p-5">
                    <h2 class="section-title mb-4">Documentacion</h2>
                    {{ form_row(form.observations, {'attr': {'rows': 3, 'placeholder': 'Entrega, permuta, pagares, condiciones acordadas...'}}) }}
                    <div class="mt-4">{{ form_row(form.saleDocumentFile) }}</div>
                </section>

                {{ form_widget(form._token) }}

                <div class="flex justify-end gap-2">
                    <a href="{{ path('app_vehiculos_index') }}" class="btn-secondary">Cancelar</a>
                    <button type="submit" class="btn-primary">Confirmar venta</button>
                </div>
            </form>
        </div>

        {# ================= Vehiculo ================= #}
        <aside class="space-y-5">
            <section class="card overflow-hidden">
                {% if vehiculo.imagenesVehiculos is not empty %}
                    <img src="{{ vich_uploader_asset(vehiculo.imagenesVehiculos|first, 'imageFile') }}" alt=""
                         class="aspect-video w-full bg-surface-2 object-cover">
                {% endif %}
                <div class="p-5">
                    <h2 class="section-title mb-3">Vehiculo</h2>
                    <p class="text-base font-semibold">
                        {{ vehiculo.version.modelo.marca.name }} {{ vehiculo.version.modelo.name }}
                    </p>
                    {% if vehiculo.version.name %}<p class="text-sm text-muted">{{ vehiculo.version.name }}</p>{% endif %}

                    <div class="mt-4 flex items-center gap-3">
                        {% if vehiculo.plateNumber %}<span class="plate">{{ vehiculo.plateNumber }}</span>{% endif %}
                        <span class="mono text-sm text-muted">{{ vehiculo.anio }}</span>
                        {{ fmt.estadoVehiculo(vehiculo.state) }}
                    </div>

                    <dl class="mt-4 space-y-3 border-t border-line pt-4">
                        <div class="flex items-baseline justify-between gap-3">
                            <dt class="field-label">Precio sugerido</dt>
                            <dd class="text-sm font-semibold">
                                {% if vehiculo.suggestedRetailPriceUsd + 0 > 0 %}{{ fmt.money(vehiculo.suggestedRetailPriceUsd, 'USD', 0) }}
                                {% elseif vehiculo.suggestedRetailPrice + 0 > 0 %}{{ fmt.money(vehiculo.suggestedRetailPrice, 'ARS', 0) }}
                                {% else %}<span class="badge-amber">sin precio</span>{% endif %}
                            </dd>
                        </div>
                        <div class="flex items-baseline justify-between gap-3">
                            <dt class="field-label">Color</dt>
                            <dd class="text-sm">{{ vehiculo.color|default('-') }}</dd>
                        </div>
                        <div class="flex items-baseline justify-between gap-3">
                            <dt class="field-label">Chasis</dt>
                            <dd class="text-xs break-all">{{ vehiculo.chassisNumber|default('-') }}</dd>
                        </div>
                    </dl>
                </div>
            </section>

            {% if vehiculo.reserva and vehiculo.reserva.status == 'Activa' %}
                <section class="card p-5">
                    <h2 class="section-title mb-3">Viene de una reserva</h2>
                    <p class="text-sm font-medium">
                        {{ vehiculo.reserva.cliente.firstName }} {{ vehiculo.reserva.cliente.lastName }}
                    </p>
                    <p class="mt-1 text-sm text-muted">
                        Seña de {{ fmt.money(vehiculo.reserva.reservationAmount, vehiculo.reserva.reservationCurrency|default('ARS'), 0) }}
                    </p>
                    <p class="hint mt-2">El cliente ya viene precargado. La reserva se marca como completada al confirmar.</p>
                </section>
            {% endif %}
        </aside>
    </div>

    {# ---- Alta rapida de cliente ---- #}
    <dialog data-quick-create-target="dialog" data-kind="cliente" class="modal max-w-md">
        <form action="{{ path('app_catalogo_cliente_rapido') }}" data-action="quick-create#submit">
            <div class="modal-header">
                <h3 class="font-semibold">Nuevo cliente</h3>
                <p class="hint mt-0.5">Si el documento ya existe, se usa ese cliente.</p>
            </div>
            <div class="space-y-3 px-5 py-4">
                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <label class="label">Nombre</label>
                        <input name="firstName" required class="input">
                    </div>
                    <div>
                        <label class="label">Apellido</label>
                        <input name="lastName" required class="input">
                    </div>
                </div>
                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <label class="label">DNI</label>
                        <input name="documentNumber" required class="input" inputmode="numeric">
                    </div>
                    <div>
                        <label class="label">Telefono</label>
                        <input name="phone" class="input" inputmode="tel">
                    </div>
                </div>
                <p data-error class="hidden rounded-lg bg-red-50 px-3 py-2 text-xs text-red-700 dark:bg-red-500/10 dark:text-red-300"></p>
            </div>
            <div class="modal-footer">
                <button type="button" data-action="quick-create#close" class="btn-secondary btn-sm">Cancelar</button>
                <button type="submit" class="btn-primary btn-sm">Crear y seleccionar</button>
            </div>
        </form>
    </dialog>
</div>
{% endblock %}
