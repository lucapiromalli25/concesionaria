<!DOCTYPE html>
<html lang="es" class="h-full">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Ingresar - Atilio Automotores</title>
    <link rel="icon" href="{{ asset('assets/img/kaiadmin/favicon.ico') }}" type="image/x-icon"/>
    <script>
        (function () {
            document.documentElement.classList.toggle('dark', localStorage.getItem('tema') === 'dark');
        })();
    </script>
    {{ importmap('app') }}
</head>
<body class="h-full">
<div class="flex min-h-full items-center justify-center px-4 py-12">
    <div class="w-full max-w-sm">
        <div class="mb-6 flex flex-col items-center gap-3 text-center">
            <img src="{{ asset('assets/img/kaiadmin/atilio_automotores.png') }}" alt="Atilio Automotores" class="h-16 w-auto">
            <h1 class="text-lg font-semibold tracking-tight">Atilio Automotores</h1>
        </div>

        <form method="post" class="card p-6">
            {% if error %}
                <div class="mb-4 rounded-lg border border-red-200 bg-red-50 px-3 py-2 text-sm text-red-800 dark:border-red-400/25 dark:bg-red-500/10 dark:text-red-300">
                    {{ error.messageKey|trans(error.messageData, 'security') }}
                </div>
            {% endif %}

            <div class="space-y-4">
                <div>
                    <label for="inputDni" class="label">DNI</label>
                    <input type="text" name="_username" id="inputDni" value="{{ last_username }}"
                           class="input" inputmode="numeric" autocomplete="username" required autofocus>
                </div>

                <div>
                    <label for="inputPassword" class="label">Contraseña</label>
                    <input type="password" name="_password" id="inputPassword"
                           class="input" autocomplete="current-password" required>
                </div>
            </div>

            <input type="hidden" name="_csrf_token" data-controller="csrf-protection" value="{{ csrf_token('authenticate') }}">

            <button type="submit" class="btn-primary mt-6 w-full">Ingresar</button>
        </form>

        <p class="mt-6 text-center text-xs text-subtle">Sistema de gestion interna</p>
    </div>
</div>
</body>
</html>
