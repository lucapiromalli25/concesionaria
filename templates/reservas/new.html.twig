{% extends 'layout.html.twig' %}

{% block title %}Reservar vehiculo - Atilio Automotores{% endblock %}
{% block page_title %}Reservar vehiculo{% endblock %}
{% block page_subtitle %}
    <p class="text-xs text-muted">{{ vehiculo.version.modelo.marca.name }} {{ vehiculo.version.modelo.name }}{% if vehiculo.plateNumber %} - {{ vehiculo.plateNumber }}{% endif %}</p>
{% endblock %}

{% block body %}
    {% include 'reservas/_form.html.twig' with {
        'cancelPath': path('app_vehiculos_index'),
        'submitLabel': 'Confirmar reserva'
    } %}
{% endblock %}
