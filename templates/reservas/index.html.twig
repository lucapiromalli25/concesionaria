{% extends 'layout.html.twig' %}
{% import 'partials/icons.html.twig' as icons %}
{% import 'partials/format.html.twig' as fmt %}

{% block title %}Reservas - Atilio Automotores{% endblock %}
{% block page_title %}Reservas{% endblock %}
{% block page_subtitle %}
    <p class="text-xs text-muted">{{ total }} reserva{{ total == 1 ? '' : 's' }}</p>
{% endblock %}

{% block page_actions %}
    <a href="{{ path('app_vehiculos_index', {'estado': 'En Stock'}) }}" class="btn-primary btn-sm">
        {{ icons.icon('plus', 'size-4') }}<span class="hidden sm:inline">Reservar un vehiculo</span>
    </a>
{% endblock %}

{% block body %}
    {% if resumen.vencidas %}
        <a href="{{ path('app_reservas_index', {'estado': 'vencida'}) }}" data-turbo="false"
           class="mb-5 flex items-start gap-3 rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm
                  text-red-800 transition hover:border-red-300 dark:border-red-400/25 dark:bg-red-500/10 dark:text-red-300">
            {{ icons.icon('alert', 'size-5 shrink-0') }}
            <div>
                <p class="font-medium">
                    {{ resumen.vencidas }} de las {{ resumen.activas }} reservas activas ya vencieron
                </p>
                <p class="mt-0.5">El vehiculo sigue bloqueado en "Reservado" hasta que la canceles o la conviertas en venta.</p>
            </div>
        </a>
    {% endif %}

    <turbo-frame id="reservas" data-turbo-action="advance" class="block">
        <div class="card overflow-hidden">

            <form method="get" action="{{ path('app_reservas_index') }}"
                  data-controller="filter-form"
                  class="flex flex-wrap items-end gap-3 border-b border-line bg-surface-2 p-4">
                <div class="relative min-w-64 flex-1">
                    <span class="pointer-events-none absolute inset-y-0 left-3 flex items-center text-subtle">
                        {{ icons.icon('search', 'size-4') }}
                    </span>
                    <input type="search" name="q" value="{{ q }}" autocomplete="off"
                           placeholder="Buscar por cliente, DNI, patente, vehiculo o recibo" class="input pl-9">
                </div>
                <select name="estado" class="input w-48">
                    <option value="">Todos los estados</option>
                    <option value="Activa" {{ estado == 'Activa' ? 'selected' }}>Activas</option>
                    <option value="vencida" {{ estado == 'vencida' ? 'selected' }}>Activas vencidas</option>
                    <option value="Completada" {{ estado == 'Completada' ? 'selected' }}>Completadas</option>
                    <option value="Cancelada" {{ estado == 'Cancelada' ? 'selected' }}>Canceladas</option>
                </select>
                <button type="submit" class="btn-primary">{{ icons.icon('search', 'size-4') }} Buscar</button>
                {% if q or estado %}
                    <a href="{{ path('app_reservas_index') }}" class="btn-ghost btn-sm">{{ icons.icon('x', 'size-4') }} Limpiar</a>
                {% endif %}
            </form>

            <div class="table-wrap">
                <table class="table">
                    <thead>
                        <tr>
                            <th>Recibo</th>
                            <th>Fecha</th>
                            <th>Vehiculo</th>
                            <th>Cliente</th>
                            <th>Vence</th>
                            <th class="text-right">Seña</th>
                            <th>Estado</th>
                            <th class="text-right">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                    {% for reserva in reservas %}
                        {% set vencida = reserva.status == 'Activa' and reserva.expirationDate and reserva.expirationDate < date('today') %}
                        <tr>
                            <td class="text-xs text-muted">{{ reserva.receiptNumber|default('#' ~ reserva.id) }}</td>
                            <td class="mono">{{ reserva.reservationDate ? reserva.reservationDate|date('d/m/Y') : '-' }}</td>
                            <td>
                                <a href="{{ path('app_vehiculos_show', {'id': reserva.vehiculo.id}) }}" class="font-medium hover:text-accent-text">
                                    {{ reserva.vehiculo.version.modelo.marca.name }} {{ reserva.vehiculo.version.modelo.name }}
                                </a>
                                {% if reserva.vehiculo.plateNumber %}
                                    <div class="mt-0.5"><span class="plate">{{ reserva.vehiculo.plateNumber }}</span></div>
                                {% endif %}
                            </td>
                            <td>
                                <p class="font-medium">{{ reserva.cliente.firstName }} {{ reserva.cliente.lastName }}</p>
                                <p class="mono text-xs text-subtle">{{ reserva.cliente.documentNumber }}</p>
                            </td>
                            <td class="mono {{ vencida ? 'font-medium text-red-600 dark:text-red-400' : '' }}">
                                {{ reserva.expirationDate ? reserva.expirationDate|date('d/m/Y') : '-' }}
                            </td>
                            <td class="text-right font-medium">
                                {{ fmt.money(reserva.reservationAmount, reserva.reservationCurrency|default('ARS'), 0) }}
                            </td>
                            <td>{{ fmt.estadoReserva(reserva) }}</td>
                            <td>
                                <div class="flex items-center justify-end gap-1">
                                    {% if reserva.status == 'Activa' %}
                                        <a href="{{ path('app_ventas_new', {'id': reserva.vehiculo.id}) }}"
                                           class="btn-primary btn-sm" data-turbo="false">Vender</a>
                                    {% endif %}
                                    <a href="{{ path('app_reservas_edit', {'id': reserva.id}) }}" title="Editar"
                                       class="btn-ghost btn-sm" data-turbo="false">{{ icons.icon('pencil', 'size-4') }}</a>
                                    <a href="{{ path('app_reservas_view_pdf', {'id': reserva.id}) }}" target="_blank"
                                       title="Recibo" class="btn-ghost btn-sm">{{ icons.icon('document', 'size-4') }}</a>
                                </div>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="8" class="py-16 text-center">
                                <div class="mx-auto flex max-w-sm flex-col items-center gap-2 text-subtle">
                                    {{ icons.icon('calendar', 'size-8') }}
                                    <p class="text-sm font-medium text-muted">No se encontraron reservas</p>
                                </div>
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>

            {% if total > 0 %}
                <div class="flex flex-wrap items-center justify-between gap-3 border-t border-line bg-surface-2 px-4 py-3">
                    <p class="text-xs text-muted">
                        Mostrando <span class="font-medium text-fg">{{ (currentPage - 1) * 25 + 1 }}-{{ min(currentPage * 25, total) }}</span>
                        de <span class="font-medium text-fg">{{ total }}</span>
                    </p>
                    <div class="flex items-center gap-1">
                        <a href="{{ path('app_reservas_index', app.request.query.all|merge({'page': currentPage - 1})) }}"
                           class="btn-ghost btn-sm {{ currentPage == 1 ? 'pointer-events-none opacity-40' : '' }}">
                            {{ icons.icon('chevron-left', 'size-4') }}
                        </a>
                        {% for p in 1..totalPages %}
                            {% if p == 1 or p == totalPages or (p >= currentPage - 1 and p <= currentPage + 1) %}
                                <a href="{{ path('app_reservas_index', app.request.query.all|merge({'page': p})) }}"
                                   class="btn-sm {{ p == currentPage ? 'btn-primary' : 'btn-ghost' }} min-w-8">{{ p }}</a>
                            {% elseif p == 2 or p == totalPages - 1 %}
                                <span class="px-1 text-subtle">...</span>
                            {% endif %}
                        {% endfor %}
                        <a href="{{ path('app_reservas_index', app.request.query.all|merge({'page': currentPage + 1})) }}"
                           class="btn-ghost btn-sm {{ currentPage == totalPages ? 'pointer-events-none opacity-40' : '' }}">
                            {{ icons.icon('chevron-right', 'size-4') }}
                        </a>
                    </div>
                </div>
            {% endif %}
        </div>
    </turbo-frame>
{% endblock %}
