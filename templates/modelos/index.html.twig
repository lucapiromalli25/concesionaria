{% extends 'layout.html.twig' %}
{% import 'partials/icons.html.twig' as icons %}

{% block title %}Modelos - Atilio Automotores{% endblock %}
{% block page_title %}Modelos{% endblock %}
{% block page_subtitle %}
    <p class="text-xs text-muted">{{ total }} modelo{{ total == 1 ? '' : 's' }}</p>
{% endblock %}

{% block page_actions %}
    {% if is_granted('catalogo.crear') %}
        <button type="button" class="btn-primary btn-sm"
                data-action="remote-dialog#open"
                data-dialog-url="{{ path('app_modelos_new') }}"
                data-dialog-title="Nuevo modelo">
            {{ icons.icon('plus', 'size-4') }}<span class="hidden sm:inline">Nuevo modelo</span>
        </button>
    {% endif %}
{% endblock %}

{% block body %}
<div>
    {% if duplicados|length and not q and not marcaId %}
        <div class="mb-5 flex items-start gap-3 rounded-lg border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-800 dark:border-amber-400/25 dark:bg-amber-500/10 dark:text-amber-300">
            {{ icons.icon('alert', 'size-5 shrink-0') }}
            <div>
                <p class="font-medium">{{ duplicados|length }} modelos repetidos dentro de la misma marca</p>
                <p class="mt-0.5">Aparecen marcados en la lista. Conviene dejar uno solo y mover los vehiculos ahi.</p>
            </div>
        </div>
    {% endif %}

    <turbo-frame id="modelos" data-turbo-action="advance" class="block">
        <div class="card overflow-hidden">
            <form method="get" action="{{ path('app_modelos_index') }}"
                  data-controller="filter-form"
                  class="flex flex-wrap items-end gap-3 border-b border-line bg-surface-2 p-4">
                <div class="relative min-w-64 flex-1">
                    <span class="pointer-events-none absolute inset-y-0 left-3 flex items-center text-subtle">
                        {{ icons.icon('search', 'size-4') }}
                    </span>
                    <input type="search" name="q" value="{{ q }}" autocomplete="off"
                           placeholder="Buscar modelo o marca" class="input pl-9">
                </div>
                <select name="marca" class="input w-48">
                    <option value="">Todas las marcas</option>
                    {% for marca in marcas %}
                        <option value="{{ marca.id }}" {{ marcaId == marca.id ? 'selected' }}>{{ marca.name }}</option>
                    {% endfor %}
                </select>
                <button type="submit" class="btn-primary">{{ icons.icon('search', 'size-4') }} Buscar</button>
                {% if q or marcaId %}
                    <a href="{{ path('app_modelos_index') }}" class="btn-ghost btn-sm">{{ icons.icon('x', 'size-4') }} Limpiar</a>
                {% endif %}
            </form>

            <div class="table-wrap">
                <table class="table">
                    <thead>
                        <tr>
                            <th>Marca</th>
                            <th>Modelo</th>
                            <th class="text-right">Versiones</th>
                            <th class="text-right">Vehiculos</th>
                            <th class="text-right">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                    {% for fila in filas %}
                        {% set modelo = fila[0] %}
                        {% set repetido = duplicados[modelo.marca.id ~ '|' ~ (modelo.name|lower|trim)]|default(0) %}
                        <tr>
                            <td class="text-muted">{{ modelo.marca.name }}</td>
                            <td>
                                <span class="font-medium">{{ modelo.name }}</span>
                                {% if repetido > 1 %}
                                    <span class="badge-amber ml-1.5" title="Este nombre esta cargado {{ repetido }} veces en {{ modelo.marca.name }}">
                                        x{{ repetido }}
                                    </span>
                                {% endif %}
                            </td>
                            <td class="mono text-right text-muted">{{ fila.versiones }}</td>
                            <td class="text-right">
                                {% if fila.vehiculos > 0 %}
                                    <span class="badge-accent">{{ fila.vehiculos }}</span>
                                {% else %}
                                    <span class="text-xs text-subtle">sin uso</span>
                                {% endif %}
                            </td>
                            <td>
                                <div class="flex items-center justify-end gap-1">
                                    <a href="{{ path('app_versiones_index', {'q': modelo.name}) }}" class="btn-ghost btn-sm"
                                       data-turbo="false" title="Ver versiones">{{ icons.icon('tag', 'size-4') }}</a>
                                    {% if is_granted('catalogo.editar') %}
                                        <button type="button" class="btn-ghost btn-sm" title="Editar"
                                                data-action="remote-dialog#open"
                                                data-dialog-url="{{ path('app_modelos_edit', {'id': modelo.id}) }}"
                                                data-dialog-title="Editar modelo">
                                            {{ icons.icon('pencil', 'size-4') }}
                                        </button>
                                    {% endif %}
                                </div>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="5" class="py-16 text-center">
                                <div class="mx-auto flex max-w-sm flex-col items-center gap-2 text-subtle">
                                    {{ icons.icon('tag', 'size-8') }}
                                    <p class="text-sm font-medium text-muted">No se encontraron modelos</p>
                                </div>
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>

            {% if total > 25 %}
                <div class="flex flex-wrap items-center justify-between gap-3 border-t border-line bg-surface-2 px-4 py-3">
                    <p class="text-xs text-muted">
                        Mostrando <span class="font-medium text-fg">{{ (currentPage - 1) * 25 + 1 }}-{{ min(currentPage * 25, total) }}</span>
                        de <span class="font-medium text-fg">{{ total }}</span>
                    </p>
                    <div class="flex items-center gap-1">
                        <a href="{{ path('app_modelos_index', app.request.query.all|merge({'page': currentPage - 1})) }}"
                           class="btn-ghost btn-sm {{ currentPage == 1 ? 'pointer-events-none opacity-40' : '' }}">
                            {{ icons.icon('chevron-left', 'size-4') }}
                        </a>
                        {% for p in 1..totalPages %}
                            {% if p == 1 or p == totalPages or (p >= currentPage - 1 and p <= currentPage + 1) %}
                                <a href="{{ path('app_modelos_index', app.request.query.all|merge({'page': p})) }}"
                                   class="btn-sm {{ p == currentPage ? 'btn-primary' : 'btn-ghost' }} min-w-8">{{ p }}</a>
                            {% elseif p == 2 or p == totalPages - 1 %}
                                <span class="px-1 text-subtle">...</span>
                            {% endif %}
                        {% endfor %}
                        <a href="{{ path('app_modelos_index', app.request.query.all|merge({'page': currentPage + 1})) }}"
                           class="btn-ghost btn-sm {{ currentPage == totalPages ? 'pointer-events-none opacity-40' : '' }}">
                            {{ icons.icon('chevron-right', 'size-4') }}
                        </a>
                    </div>
                </div>
            {% endif %}
        </div>
    </turbo-frame>

    <dialog data-remote-dialog-target="dialog" class="modal max-w-sm">
        <div class="modal-header flex items-center justify-between">
            <h3 class="font-semibold" data-remote-dialog-target="title"></h3>
            <button type="button" data-action="remote-dialog#close" class="btn-ghost btn-icon">
                {{ icons.icon('x', 'size-4') }}
            </button>
        </div>
        <div data-remote-dialog-target="content"></div>
    </dialog>
</div>
{% endblock %}
