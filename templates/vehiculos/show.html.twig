{% extends 'layout.html.twig' %}
{% import 'partials/icons.html.twig' as icons %}
{% import 'partials/format.html.twig' as fmt %}

{% set venta = vehiculo.venta %}
{% set reserva = vehiculo.reserva %}
{% set moneda = venta ? venta.saleCurrency|default('ARS') : 'ARS' %}

{% block title %}{{ vehiculo.version.modelo.marca.name }} {{ vehiculo.version.modelo.name }} - Atilio Automotores{% endblock %}
{% block page_title %}{{ vehiculo.version.modelo.marca.name }} {{ vehiculo.version.modelo.name }}{% endblock %}
{% block page_subtitle %}
    <p class="text-xs text-muted">#{{ vehiculo.id }}{% if vehiculo.version.name %} - {{ vehiculo.version.name }}{% endif %}</p>
{% endblock %}

{% block page_actions %}
    <a href="{{ path('app_vehiculos_index') }}" class="btn-secondary btn-sm">Volver</a>
    {% if is_granted('vehiculos.editar') %}
        <a href="{{ path('app_vehiculos_edit', {'id': vehiculo.id}) }}" class="btn-secondary btn-sm">Editar</a>
    {% endif %}
    {% if vehiculo.state == 'En Stock' %}
        <a href="{{ path('app_reservas_new', {'id': vehiculo.id}) }}" class="btn-secondary btn-sm">Reservar</a>
    {% endif %}
    {% if vehiculo.state in ['En Stock', 'Reservado'] %}
        <a href="{{ path('app_ventas_new', {'id': vehiculo.id}) }}" class="btn-primary btn-sm">Vender</a>
    {% endif %}
{% endblock %}

{% block body %}
<div class="grid gap-5 lg:grid-cols-[minmax(0,1fr)_360px]">

    {# ================= Columna principal ================= #}
    <div class="space-y-5">

        {# ---- Cabecera: identificacion del auto ---- #}
        <section class="card overflow-hidden">
            <div class="flex flex-wrap items-center gap-x-6 gap-y-3 p-5">
                <div>
                    <p class="field-label">Patente</p>
                    <div class="mt-1">
                        {% if vehiculo.plateNumber %}
                            <span class="plate plate-lg">{{ vehiculo.plateNumber }}</span>
                        {% else %}
                            <span class="badge-accent">0 km</span>
                        {% endif %}
                    </div>
                </div>
                <div class="h-10 w-px bg-line"></div>
                <div>
                    <p class="field-label">Estado</p>
                    <div class="mt-1.5">{{ fmt.estadoVehiculo(vehiculo.state) }}</div>
                </div>
                <div>
                    <p class="field-label">Año</p>
                    <p class="field-value mono">{{ vehiculo.anio }}</p>
                </div>
                <div>
                    <p class="field-label">Kilometros</p>
                    <p class="field-value mono">
                        {{ vehiculo.kilometers ? vehiculo.kilometers|number_format(0, ',', '.') ~ ' km' : '-' }}
                    </p>
                </div>
                <div>
                    <p class="field-label">Color</p>
                    <p class="field-value">{{ vehiculo.color|default('-') }}</p>
                </div>
                <div class="ml-auto text-right">
                    <p class="field-label">Precio sugerido</p>
                    <p class="mt-0.5 text-lg font-semibold">
                        {% if vehiculo.suggestedRetailPriceUsd + 0 > 0 %}
                            {{ fmt.money(vehiculo.suggestedRetailPriceUsd, 'USD', 0) }}
                        {% elseif vehiculo.suggestedRetailPrice + 0 > 0 %}
                            {{ fmt.money(vehiculo.suggestedRetailPrice, 'ARS', 0) }}
                        {% else %}
                            <span class="badge-amber">sin precio</span>
                        {% endif %}
                    </p>
                </div>
            </div>
        </section>

        {# ---- Fotos ---- #}
        <section class="card overflow-hidden" data-controller="gallery">
            {% if vehiculo.imagenesVehiculos is not empty %}
                <img data-gallery-target="main" src="{{ vich_uploader_asset(vehiculo.imagenesVehiculos|first, 'imageFile') }}"
                     alt="" class="aspect-video w-full bg-surface-2 object-cover">
                {% if vehiculo.imagenesVehiculos|length > 1 %}
                    <div class="flex gap-2 overflow-x-auto p-3">
                        {% for imagen in vehiculo.imagenesVehiculos %}
                            <button type="button" data-action="gallery#select"
                                    data-src="{{ vich_uploader_asset(imagen, 'imageFile') }}"
                                    class="size-16 shrink-0 overflow-hidden rounded-lg border border-line transition hover:opacity-80">
                                <img src="{{ vich_uploader_asset(imagen, 'imageFile') }}" alt="" class="size-full object-cover">
                            </button>
                        {% endfor %}
                    </div>
                {% endif %}
            {% else %}
                <div class="flex flex-col items-center gap-2 px-6 py-14 text-subtle">
                    {{ icons.icon('car', 'size-8') }}
                    <p class="text-sm">Sin fotos cargadas</p>
                    {% if is_granted('vehiculos.editar') %}
                        <a href="{{ path('app_vehiculos_edit', {'id': vehiculo.id}) }}" class="btn-secondary btn-sm mt-1">Agregar fotos</a>
                    {% endif %}
                </div>
            {% endif %}
        </section>

        {# ---- Plan de pagos ---- #}
        {% if venta and venta.cuotas|length %}
            <section class="card overflow-hidden">
                <div class="flex items-center justify-between border-b border-line px-5 py-3">
                    <h2 class="section-title">Plan de pagos</h2>
                    {% if venta.isPaymentOverdue() %}
                        <span class="badge-red">Con cuotas vencidas</span>
                    {% else %}
                        <span class="badge-green">Al dia</span>
                    {% endif %}
                </div>
                <div class="table-wrap">
                    <table class="table">
                        <thead>
                            <tr>
                                <th>Cuota</th>
                                <th>Vencimiento</th>
                                <th class="text-right">Monto</th>
                                <th class="text-right">Pagado</th>
                                <th>Estado</th>
                                <th>Fecha de pago</th>
                                <th class="text-right">Comprobante</th>
                            </tr>
                        </thead>
                        <tbody>
                        {% for cuota in venta.cuotas|sort((a, b) => a.installmentNumber <=> b.installmentNumber) %}
                            <tr>
                                <td class="mono font-medium">{{ cuota.installmentNumber }}</td>
                                <td class="mono">{{ cuota.dueDate|date('d/m/Y') }}</td>
                                <td class="text-right">{{ fmt.money(cuota.amount, moneda) }}</td>
                                <td class="text-right">
                                    {% if cuota.paidAmount %}{{ fmt.money(cuota.paidAmount, cuota.paidCurrency|default(moneda)) }}
                                    {% else %}<span class="text-subtle">-</span>{% endif %}
                                </td>
                                <td>{{ fmt.estadoCuota(cuota) }}</td>
                                <td class="mono text-muted">{{ cuota.paymentDate ? cuota.paymentDate|date('d/m/Y') : '-' }}</td>
                                <td class="text-right">
                                    {% if cuota.receiptName %}
                                        <a href="{{ vich_uploader_asset(cuota, 'receiptFile') }}" target="_blank" class="btn-ghost btn-sm">
                                            {{ icons.icon('eye', 'size-4') }}
                                        </a>
                                    {% else %}
                                        <span class="text-subtle">-</span>
                                    {% endif %}
                                </td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
            </section>
        {% endif %}

        {# ---- Notas ---- #}
        {% if vehiculo.internalObservations or vehiculo.version.characteristics %}
            <section class="card p-5">
                <h2 class="section-title mb-3">Notas</h2>
                {% if vehiculo.internalObservations %}
                    <p class="text-sm whitespace-pre-line">{{ vehiculo.internalObservations }}</p>
                {% endif %}
                {% if vehiculo.version.characteristics %}
                    <p class="mt-3 text-sm text-muted whitespace-pre-line">{{ vehiculo.version.characteristics }}</p>
                {% endif %}
            </section>
        {% endif %}
    </div>

    {# ================= Columna lateral ================= #}
    <div class="space-y-5">

        {# ---- Venta ---- #}
        {% if venta %}
            <section class="card p-5">
                <div class="mb-4 flex items-center justify-between">
                    <h2 class="section-title">Venta</h2>
                    <a href="{{ path('app_ventas_show', {'id': venta.id}) }}" class="text-xs font-medium text-accent-text hover:underline">Ver venta</a>
                </div>
                <dl class="space-y-3">
                    <div class="flex items-baseline justify-between gap-3">
                        <dt class="field-label">Comprobante</dt>
                        <dd class="mono text-sm">{{ venta.receiptNumber|default('-') }}</dd>
                    </div>
                    <div class="flex items-baseline justify-between gap-3">
                        <dt class="field-label">Cliente</dt>
                        <dd class="text-sm font-medium">{{ venta.cliente.firstName }} {{ venta.cliente.lastName }}</dd>
                    </div>
                    <div class="flex items-baseline justify-between gap-3">
                        <dt class="field-label">Fecha</dt>
                        <dd class="mono text-sm">{{ venta.saleDate|date('d/m/Y') }}</dd>
                    </div>
                    <div class="flex items-baseline justify-between gap-3">
                        <dt class="field-label">Forma de pago</dt>
                        <dd class="text-sm">{{ venta.paymentMethod|default('-') }}</dd>
                    </div>
                    <div class="flex items-baseline justify-between gap-3 border-t border-line pt-3">
                        <dt class="field-label">Precio final</dt>
                        <dd class="text-base font-semibold">{{ fmt.money(venta.finalSalePrice, moneda, 0) }}</dd>
                    </div>
                    {% if venta.cuotas|length %}
                        <div class="flex items-baseline justify-between gap-3">
                            <dt class="field-label">Saldo pendiente</dt>
                            <dd class="text-sm font-medium">{{ fmt.money(venta.getPendingBalance(), moneda, 0) }}</dd>
                        </div>
                    {% endif %}
                </dl>
            </section>
        {% endif %}

        {# ---- Reserva ---- #}
        {% if reserva %}
            <section class="card p-5">
                <div class="mb-4 flex items-center justify-between">
                    <h2 class="section-title">Reserva</h2>
                    {{ fmt.estadoReserva(reserva) }}
                </div>
                <dl class="space-y-3">
                    <div class="flex items-baseline justify-between gap-3">
                        <dt class="field-label">Cliente</dt>
                        <dd class="text-sm font-medium">{{ reserva.cliente.firstName }} {{ reserva.cliente.lastName }}</dd>
                    </div>
                    <div class="flex items-baseline justify-between gap-3">
                        <dt class="field-label">Seña</dt>
                        <dd class="text-sm font-medium">{{ fmt.money(reserva.reservationAmount, reserva.reservationCurrency|default('ARS'), 0) }}</dd>
                    </div>
                    <div class="flex items-baseline justify-between gap-3">
                        <dt class="field-label">Vence</dt>
                        <dd class="mono text-sm">{{ reserva.expirationDate ? reserva.expirationDate|date('d/m/Y') : '-' }}</dd>
                    </div>
                </dl>
                <div class="mt-4 flex gap-2">
                    <a href="{{ path('app_reservas_edit', {'id': reserva.id}) }}" class="btn-secondary btn-sm flex-1">Editar</a>
                    <a href="{{ path('app_reservas_view_pdf', {'id': reserva.id}) }}" target="_blank" class="btn-secondary btn-sm flex-1">Recibo</a>
                </div>
            </section>
        {% endif %}

        {# ---- Compra ---- #}
        <section class="card p-5">
            <h2 class="section-title mb-4">Compra</h2>
            <dl class="space-y-3">
                <div class="flex items-baseline justify-between gap-3">
                    <dt class="field-label">Proveedor</dt>
                    <dd class="text-sm font-medium text-right">{{ vehiculo.supplier ? vehiculo.supplier.name : '-' }}</dd>
                </div>
                {% if vehiculo.supplier and vehiculo.supplier.phone %}
                    <div class="flex items-baseline justify-between gap-3">
                        <dt class="field-label">Telefono</dt>
                        <dd class="mono text-sm">{{ vehiculo.supplier.phone }}</dd>
                    </div>
                {% endif %}
                <div class="flex items-baseline justify-between gap-3">
                    <dt class="field-label">Ingreso</dt>
                    <dd class="mono text-sm">{{ vehiculo.entryDate ? vehiculo.entryDate|date('d/m/Y') : '-' }}</dd>
                </div>
                {% if is_granted('vehiculos.ver_precio_compra') %}
                    <div class="flex items-baseline justify-between gap-3">
                        <dt class="field-label">Costo</dt>
                        <dd class="text-sm font-medium">
                            {% if vehiculo.purchasePriceUsd + 0 > 0 %}{{ fmt.money(vehiculo.purchasePriceUsd, 'USD', 0) }}
                            {% elseif vehiculo.purchasePrice + 0 > 0 %}{{ fmt.money(vehiculo.purchasePrice, 'ARS', 0) }}
                            {% else %}<span class="text-subtle">sin cargar</span>{% endif %}
                        </dd>
                    </div>
                {% endif %}
            </dl>
            {% if vehiculo.purchaseDocumentName and is_granted('vehiculos.ver_documentos') %}
                <a href="{{ vich_uploader_asset(vehiculo, 'purchaseDocumentFile') }}" target="_blank" class="btn-secondary btn-sm mt-4 w-full">
                    {{ icons.icon('document', 'size-4') }} Boleto de compra
                </a>
            {% endif %}
        </section>

        {# ---- Datos tecnicos ---- #}
        <section class="card p-5">
            <h2 class="section-title mb-4">Datos tecnicos</h2>
            <dl class="space-y-3">
                <div>
                    <dt class="field-label">Chasis</dt>
                    <dd class="mono mt-0.5 text-sm break-all">{{ vehiculo.chassisNumber|default('-') }}</dd>
                </div>
                <div>
                    <dt class="field-label">Motor</dt>
                    <dd class="mono mt-0.5 text-sm break-all">{{ vehiculo.engineNumber|default('-') }}</dd>
                </div>
            </dl>
            <div class="mt-4 border-t border-line pt-3 text-xs text-subtle">
                <p>Cargado {{ vehiculo.createdAt|date('d/m/Y') }}{% if vehiculo.createdBy %} por {{ vehiculo.createdBy.completeName }}{% endif %}</p>
                <p>Modificado {{ vehiculo.updatedAt|date('d/m/Y') }}{% if vehiculo.updatedBy %} por {{ vehiculo.updatedBy.completeName }}{% endif %}</p>
            </div>
        </section>
    </div>
</div>
{% endblock %}
