{% extends 'layout.html.twig' %}
{% import 'partials/icons.html.twig' as icons %}
{% import 'partials/table.html.twig' as tbl %}

{% block title %}Inventario - Atilio Automotores{% endblock %}
{% block page_title %}Inventario{% endblock %}
{% block page_subtitle %}
    <p class="text-sm text-muted">{{ total }} vehiculo{{ total == 1 ? '' : 's' }}{% if filters.q or filters.estado or filters.marca or filters.anioMin or filters.anioMax %} que coinciden con el filtro{% endif %}</p>
{% endblock %}

{% block page_actions %}
    {% if is_granted('reportes.exportar') %}
        <a href="{{ path('app_report_export_vehicles') }}" class="btn-secondary btn-sm">
            {{ icons.icon('excel', 'size-4') }}<span class="hidden sm:inline">Exportar</span>
        </a>
    {% endif %}
    {% if is_granted('vehiculos.crear') %}
        <a href="{{ path('app_vehiculos_new') }}" class="btn-primary btn-sm">
            {{ icons.icon('plus', 'size-4') }}<span class="hidden sm:inline">Agregar vehiculo</span>
        </a>
    {% endif %}
{% endblock %}

{% block body %}
    {# ---------- Resumen por estado ---------- #}
    <div class="mb-5 grid grid-cols-2 gap-3 lg:grid-cols-4">
        {% set tarjetas = [
            { label: 'En stock',  value: counts['En Stock']|default(0),  estado: 'En Stock',  ring: 'ring-1 ring-emerald-500/25', dot: 'bg-emerald-500' },
            { label: 'Reservados',value: counts['Reservado']|default(0), estado: 'Reservado', ring: 'ring-1 ring-sky-500/25',   dot: 'bg-sky-500' },
            { label: 'Vendidos',  value: counts['Vendido']|default(0),   estado: 'Vendido',   ring: 'ring-1 ring-line',   dot: 'bg-stone-400' },
            { label: 'Total',     value: counts|reduce((c, v) => c + v, 0), estado: '',       ring: 'ring-1 ring-accent/30',   dot: 'bg-accent' }
        ] %}
        {% for t in tarjetas %}
            <a href="{{ path('app_vehiculos_index', app.request.query.all|merge({'estado': t.estado, 'page': 1})) }}"
               class="card flex items-center gap-3 px-4 py-3 ring-1 {{ t.ring }} transition hover:shadow-md
                      {{ filters.estado == t.estado and t.estado ? 'ring-2' : '' }}">
                <span class="size-2.5 shrink-0 rounded-full {{ t.dot }}"></span>
                <div class="min-w-0">
                    <p class="text-xl font-semibold text-fg">{{ t.value }}</p>
                    <p class="truncate text-xs text-muted">{{ t.label }}</p>
                </div>
            </a>
        {% endfor %}
    </div>

    <turbo-frame id="inventario" data-turbo-action="advance" class="block">
        <div class="card overflow-hidden">

            {# ---------- Filtros ---------- #}
            <form method="get" action="{{ path('app_vehiculos_index') }}"
                  data-controller="filter-form" data-action="input->filter-form#submit change->filter-form#submitNow"
                  class="flex flex-wrap items-end gap-3 border-b border-line bg-surface-2 p-4">
                <div class="relative min-w-64 flex-1">
                    <span class="pointer-events-none absolute inset-y-0 left-3 flex items-center text-subtle">
                        {{ icons.icon('search', 'size-4') }}
                    </span>
                    <input type="search" name="q" value="{{ filters.q }}" autocomplete="off"
                           placeholder="Buscar por patente, marca, modelo, chasis, motor o color"
                           class="input pl-9">
                </div>

                <div>
                    <select name="estado" class="input w-40">
                        <option value="">Todos los estados</option>
                        {% for estado in estados %}
                            <option value="{{ estado }}" {{ filters.estado == estado ? 'selected' }}>{{ estado }}</option>
                        {% endfor %}
                    </select>
                </div>

                <div>
                    <select name="marca" class="input w-44">
                        <option value="">Todas las marcas</option>
                        {% for marca in marcas %}
                            <option value="{{ marca.id }}" {{ filters.marca == marca.id ? 'selected' }}>{{ marca.name }}</option>
                        {% endfor %}
                    </select>
                </div>

                <div class="flex items-end gap-1.5">
                    <input type="number" name="anioMin" value="{{ filters.anioMin }}" placeholder="Año desde" class="input w-28" min="1900" max="2100">
                    <span class="pb-2 text-subtle">-</span>
                    <input type="number" name="anioMax" value="{{ filters.anioMax }}" placeholder="hasta" class="input w-28" min="1900" max="2100">
                </div>

                <input type="hidden" name="sort" value="{{ sort }}">
                <input type="hidden" name="dir" value="{{ dir }}">
                <input type="hidden" name="perPage" value="{{ perPage }}">

                <noscript><button type="submit" class="btn-primary">Filtrar</button></noscript>

                {% if filters.q or filters.estado or filters.marca or filters.anioMin or filters.anioMax %}
                    <a href="{{ path('app_vehiculos_index') }}" class="btn-ghost btn-sm">
                        {{ icons.icon('x', 'size-4') }} Limpiar
                    </a>
                {% endif %}
            </form>

            {# ---------- Tabla ---------- #}
            <div class="table-wrap">
                <table class="table">
                    <thead>
                        <tr>
                            {{ tbl.sortable('ID', 'id', sort, dir, 'app_vehiculos_index') }}
                            <th>Vehiculo</th>
                            <th>Patente</th>
                            {{ tbl.sortable('Año', 'anio', sort, dir, 'app_vehiculos_index') }}
                            <th>Color</th>
                            {{ tbl.sortable('Precio', 'precio', sort, dir, 'app_vehiculos_index', 'right') }}
                            {{ tbl.sortable('Estado', 'estado', sort, dir, 'app_vehiculos_index') }}
                            <th class="text-right">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                    {% for vehiculo in vehiculos %}
                        <tr>
                            <td class="text-xs text-subtle">#{{ vehiculo.id }}</td>
                            <td>
                                <a href="{{ path('app_vehiculos_show', {'id': vehiculo.id}) }}" class="font-medium text-fg hover:text-accent-text">
                                    {{ vehiculo.version.modelo.marca.name }} {{ vehiculo.version.modelo.name }}
                                </a>
                                {% if vehiculo.version.name %}
                                    <p class="text-xs text-muted">{{ vehiculo.version.name }}</p>
                                {% endif %}
                                {% if vehiculo.internalObservations %}
                                    <p class="mt-0.5 max-w-md truncate text-xs text-subtle" title="{{ vehiculo.internalObservations }}">
                                        {{ vehiculo.internalObservations }}
                                    </p>
                                {% endif %}
                            </td>
                            <td>
                                {% if vehiculo.plateNumber %}
                                    <span class="plate">{{ vehiculo.plateNumber }}</span>
                                {% else %}
                                    <span class="badge-blue">0 km</span>
                                {% endif %}
                            </td>
                            <td class="text-muted">{{ vehiculo.anio }}</td>
                            <td class="text-muted">{{ vehiculo.color }}</td>
                            <td class="text-right whitespace-nowrap">
                                {% set precioUsd = vehiculo.suggestedRetailPriceUsd|default(0) + 0 %}
                                {% set precioArs = vehiculo.suggestedRetailPrice|default(0) + 0 %}
                                {% if precioUsd > 0 %}
                                    <p class="font-semibold text-fg">USD {{ precioUsd|number_format(0, ',', '.') }}</p>
                                {% endif %}
                                {% if precioArs > 0 %}
                                    <p class="{{ precioUsd > 0 ? 'text-xs text-muted' : 'font-semibold text-fg' }}">$ {{ precioArs|number_format(0, ',', '.') }}</p>
                                {% endif %}
                                {% if precioUsd <= 0 and precioArs <= 0 %}
                                    <span class="badge-sky">sin precio</span>
                                {% endif %}
                            </td>
                            <td>
                                {% set tone = {'Vendido': 'badge-slate', 'Reservado': 'badge-sky', 'En Stock': 'badge-green'}[vehiculo.state]|default('badge-blue') %}
                                <span class="{{ tone }}">{{ vehiculo.state }}</span>
                            </td>
                            <td>
                                <div class="flex items-center justify-end gap-1">
                                    {% if vehiculo.state == 'En Stock' %}
                                        <a href="{{ path('app_reservas_new', {'id': vehiculo.id}) }}" class="btn-secondary btn-sm" data-turbo="false">Reservar</a>
                                    {% endif %}
                                    {% if vehiculo.state in ['En Stock', 'Reservado'] %}
                                        <a href="{{ path('app_ventas_new', {'id': vehiculo.id}) }}" class="btn-primary btn-sm" data-turbo="false">Vender</a>
                                    {% endif %}
                                    {% if vehiculo.state == 'Reservado' and vehiculo.reserva %}
                                        <a href="{{ path('app_reservas_view_pdf', {'id': vehiculo.reserva.id}) }}" target="_blank"
                                           title="Ver recibo de reserva" class="btn-ghost btn-sm">{{ icons.icon('document', 'size-4') }}</a>
                                    {% endif %}
                                    <a href="{{ path('app_vehiculos_show', {'id': vehiculo.id}) }}" title="Ver detalle"
                                       class="btn-ghost btn-sm" data-turbo="false">{{ icons.icon('eye', 'size-4') }}</a>
                                    <a href="{{ path('app_vehiculos_edit', {'id': vehiculo.id}) }}" title="Editar"
                                       class="btn-ghost btn-sm" data-turbo="false">{{ icons.icon('pencil', 'size-4') }}</a>
                                </div>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="8" class="py-16 text-center">
                                <div class="mx-auto flex max-w-sm flex-col items-center gap-2 text-subtle">
                                    {{ icons.icon('search', 'size-8') }}
                                    <p class="text-sm font-medium text-muted">No se encontraron vehiculos</p>
                                    <p class="text-xs">Proba con otra busqueda o limpia los filtros.</p>
                                </div>
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>

            {# ---------- Paginacion ---------- #}
            {% if total > 0 %}
                {% set from = (currentPage - 1) * perPage + 1 %}
                {% set to = min(currentPage * perPage, total) %}
                <div class="flex flex-wrap items-center justify-between gap-3 border-t border-line bg-surface-2 px-4 py-3">
                    <p class="text-xs text-muted">
                        Mostrando <span class="font-medium text-fg">{{ from }}-{{ to }}</span> de
                        <span class="font-medium text-fg">{{ total }}</span>
                    </p>

                    <div class="flex items-center gap-1">
                        <a href="{{ path('app_vehiculos_index', app.request.query.all|merge({'page': currentPage - 1})) }}"
                           class="btn-ghost btn-sm {{ currentPage == 1 ? 'pointer-events-none opacity-40' : '' }}">
                            {{ icons.icon('chevron-left', 'size-4') }}
                        </a>

                        {% for p in 1..totalPages %}
                            {% if p == 1 or p == totalPages or (p >= currentPage - 1 and p <= currentPage + 1) %}
                                <a href="{{ path('app_vehiculos_index', app.request.query.all|merge({'page': p})) }}"
                                   class="btn-sm {{ p == currentPage ? 'btn-primary' : 'btn-ghost' }} min-w-8">{{ p }}</a>
                            {% elseif p == 2 or p == totalPages - 1 %}
                                <span class="px-1 text-subtle">...</span>
                            {% endif %}
                        {% endfor %}

                        <a href="{{ path('app_vehiculos_index', app.request.query.all|merge({'page': currentPage + 1})) }}"
                           class="btn-ghost btn-sm {{ currentPage == totalPages ? 'pointer-events-none opacity-40' : '' }}">
                            {{ icons.icon('chevron-right', 'size-4') }}
                        </a>
                    </div>
                </div>
            {% endif %}
        </div>
    </turbo-frame>
{% endblock %}
