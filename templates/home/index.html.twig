{% extends 'layout.html.twig' %}
{% import 'partials/icons.html.twig' as icons %}
{% import 'partials/format.html.twig' as fmt %}
{% import 'partials/chart.html.twig' as chart %}

{% block title %}Panel - Atilio Automotores{% endblock %}
{% block page_title %}Panel{% endblock %}
{% block page_subtitle %}
    <p class="text-xs text-muted">{{ 'now'|date('l d/m/Y')|capitalize }}</p>
{% endblock %}

{% block body %}

    {# ================= Alertas accionables ================= #}
    {% if vencidas.cantidad or reservasVencidas %}
        <div class="mb-5 grid gap-3 md:grid-cols-2">
            {% if vencidas.cantidad %}
                <a href="{{ path('app_ventas_index') }}"
                   class="flex items-start gap-3 rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm
                          text-red-800 transition hover:border-red-300 dark:border-red-400/25 dark:bg-red-500/10 dark:text-red-300">
                    {{ icons.icon('alert', 'size-5 shrink-0') }}
                    <div>
                        <p class="font-medium">{{ vencidas.cantidad }} cuotas vencidas sin cobrar</p>
                        <div class="mt-1.5">{{ fmt.montos(vencidas.montos, 'text-sm') }}</div>
                    </div>
                </a>
            {% endif %}
            {% if reservasVencidas %}
                <a href="{{ path('app_reservas_index') }}"
                   class="flex items-start gap-3 rounded-lg border border-amber-200 bg-amber-50 px-4 py-3 text-sm
                          text-amber-800 transition hover:border-amber-300 dark:border-amber-400/25 dark:bg-amber-500/10 dark:text-amber-300">
                    {{ icons.icon('clock', 'size-5 shrink-0') }}
                    <div>
                        <p class="font-medium">{{ reservasVencidas }} reserva{{ reservasVencidas == 1 ? '' : 's' }} vencida{{ reservasVencidas == 1 ? '' : 's' }}</p>
                        <p class="mt-0.5">Los vehiculos siguen bloqueados en "Reservado".</p>
                    </div>
                </a>
            {% endif %}
        </div>
    {% endif %}

    {# ================= Tarjetas ================= #}
    <div class="mb-5 grid gap-3 sm:grid-cols-2 xl:grid-cols-4">

        <a href="{{ path('app_vehiculos_index', {'estado': 'En Stock'}) }}" class="card p-4 transition hover:shadow-md">
            <div class="flex items-center justify-between">
                <p class="field-label">En stock</p>
                {{ icons.icon('car', 'size-4 text-subtle') }}
            </div>
            <p class="mt-2 text-2xl font-semibold tracking-tight">{{ porEstado['En Stock']|default(0) }}</p>
            <p class="mt-1 text-xs text-muted">
                {% if inventario.USD > 0 %}{{ fmt.money(inventario.USD, 'USD', 0) }} en lista{% else %}sin precios cargados{% endif %}
            </p>
            {% if inventario.sinPrecio %}
                <p class="mt-1 text-xs text-amber-700 dark:text-amber-400">
                    {{ inventario.sinPrecio }} sin precio
                </p>
            {% endif %}
        </a>

        <a href="{{ path('app_reservas_index') }}" class="card p-4 transition hover:shadow-md">
            <div class="flex items-center justify-between">
                <p class="field-label">Reservas activas</p>
                {{ icons.icon('calendar', 'size-4 text-subtle') }}
            </div>
            <p class="mt-2 text-2xl font-semibold tracking-tight">{{ reservasActivas }}</p>
            <p class="mt-1 text-xs text-muted">
                {% if proximaReserva and proximaReserva.expirationDate %}
                    proxima vence {{ proximaReserva.expirationDate|date('d/m') }}
                {% else %}
                    sin vencimientos cargados
                {% endif %}
            </p>
        </a>

        <a href="{{ path('app_ventas_index') }}" class="card p-4 transition hover:shadow-md">
            <div class="flex items-center justify-between">
                <p class="field-label">Ventas del mes</p>
                {{ icons.icon('receipt', 'size-4 text-subtle') }}
            </div>
            <p class="mt-2 text-2xl font-semibold tracking-tight">{{ ventasMes ? ventasMes.cantidad : 0 }}</p>
            {% if is_granted('dashboard.ver_totales') %}
                <div class="mt-1.5">
                    {{ fmt.montos(ventasMes ? ventasMes.montos : {}, 'text-sm') }}
                </div>
            {% endif %}
        </a>

        {% if is_granted('dashboard.ver_totales') %}
            <div class="card p-4">
                <div class="flex items-center justify-between">
                    <p class="field-label">Por cobrar</p>
                    {{ icons.icon('cash', 'size-4 text-red-500') }}
                </div>
                <div class="mt-2">
                    {{ fmt.montos(pendiente, 'text-xl', 'text-red-600 dark:text-red-400') }}
                </div>
                <p class="mt-1.5 text-xs text-muted">en cuotas pendientes</p>
            </div>
        {% endif %}
    </div>

    <div class="grid gap-5 xl:grid-cols-3">

        {# ================= Columna principal ================= #}
        <div class="space-y-5 xl:col-span-2">

            {# ---- Operaciones por mes ---- #}
            <section class="card p-5">
                <div class="mb-4 flex items-baseline justify-between gap-3">
                    <div>
                        <h2 class="text-sm font-semibold">Operaciones por mes</h2>
                        <p class="hint mt-0.5">Cantidad de ventas cerradas en los ultimos 12 meses</p>
                    </div>
                </div>
                {{ chart.barras(ventasPorMes|map(m => {
                    'etiqueta': m.etiqueta,
                    'periodo': m.periodo,
                    'valor': m.cantidad,
                    'detalle': m.cantidad == 1 ? 'venta' : 'ventas'
                }), 140) }}
            </section>

            {# ---- Cobranzas ---- #}
            <section class="card overflow-hidden">
                <div class="flex items-center justify-between border-b border-line px-5 py-3">
                    <div>
                        <h2 class="text-sm font-semibold">Cobranzas</h2>
                        <p class="hint mt-0.5">Vencidas primero, despues lo que vence esta semana</p>
                    </div>
                </div>

                {% set filas = cuotasVencidas|merge(proximasCuotas) %}
                {% if filas|length %}
                    <div class="table-wrap">
                        <table class="table">
                            <thead>
                                <tr>
                                    <th>Vence</th>
                                    <th>Cliente</th>
                                    <th>Vehiculo</th>
                                    <th class="text-right">Cuota</th>
                                    <th class="text-right">Monto</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                            {% for cuota in filas %}
                                {% set vencida = cuota.dueDate < date('today') %}
                                <tr>
                                    <td class="mono {{ vencida ? 'text-red-600 dark:text-red-400 font-medium' : '' }}">
                                        {{ cuota.dueDate|date('d/m/Y') }}
                                    </td>
                                    <td class="font-medium">{{ cuota.venta.cliente.firstName }} {{ cuota.venta.cliente.lastName }}</td>
                                    <td class="text-muted">
                                        {{ cuota.venta.vehiculo.version.modelo.marca.name }} {{ cuota.venta.vehiculo.version.modelo.name }}
                                    </td>
                                    <td class="mono text-right text-muted">{{ cuota.installmentNumber }}/{{ cuota.venta.numberOfInstallments|default('-') }}</td>
                                    <td class="text-right font-medium">
                                        {{ fmt.money(cuota.amount, cuota.venta.saleCurrency|default('ARS'), 0) }}
                                    </td>
                                    <td class="text-right">
                                        <a href="{{ path('app_ventas_show', {'id': cuota.venta.id}) }}" class="btn-secondary btn-sm">Cobrar</a>
                                    </td>
                                </tr>
                            {% endfor %}
                            </tbody>
                        </table>
                    </div>
                {% else %}
                    <div class="flex flex-col items-center gap-2 px-6 py-12 text-subtle">
                        {{ icons.icon('check', 'size-8') }}
                        <p class="text-sm text-muted">No hay cuotas vencidas ni por vencer esta semana</p>
                    </div>
                {% endif %}
            </section>

            {# ---- Ultimos ingresos ---- #}
            <section class="card overflow-hidden">
                <div class="flex items-center justify-between border-b border-line px-5 py-3">
                    <h2 class="text-sm font-semibold">Ultimos ingresos</h2>
                    <a href="{{ path('app_vehiculos_index') }}" class="text-xs font-medium text-accent-text hover:underline">Ver inventario</a>
                </div>
                <ul class="divide-y divide-line">
                    {% for vehiculo in ultimosIngresos %}
                        <li>
                            <a href="{{ path('app_vehiculos_show', {'id': vehiculo.id}) }}"
                               class="flex items-center gap-3 px-5 py-3 transition hover:bg-surface-2">
                                <div class="min-w-0 flex-1">
                                    <p class="truncate text-sm font-medium">
                                        {{ vehiculo.version.modelo.marca.name }} {{ vehiculo.version.modelo.name }}
                                    </p>
                                    <p class="mt-0.5 text-xs text-muted">
                                        {{ vehiculo.anio }}{% if vehiculo.color %} - {{ vehiculo.color }}{% endif %}
                                    </p>
                                </div>
                                {% if vehiculo.plateNumber %}<span class="plate">{{ vehiculo.plateNumber }}</span>{% endif %}
                                {{ fmt.estadoVehiculo(vehiculo.state) }}
                            </a>
                        </li>
                    {% endfor %}
                </ul>
            </section>
        </div>

        {# ================= Columna lateral ================= #}
        <div class="space-y-5">

            {# ---- Dolar ---- #}
            {% if dolar.oficial is defined or dolar.blue is defined %}
                <section class="card p-5">
                    <h2 class="section-title mb-3">Dolar hoy</h2>
                    <dl class="space-y-2">
                        {% for casa, valor in dolar %}
                            <div class="flex items-baseline justify-between gap-3">
                                <dt class="text-sm capitalize text-muted">{{ casa }}</dt>
                                <dd class="mono text-sm font-medium">
                                    compra {{ valor.compra|number_format(0, ',', '.') }} /
                                    venta {{ valor.venta|number_format(0, ',', '.') }}
                                </dd>
                            </div>
                        {% endfor %}
                    </dl>
                    <p class="hint mt-3">Fuente dolarapi.com. La conversion de precios usa la cotizacion configurada, no esta.</p>
                </section>
            {% endif %}

            {# ---- Acumulado ---- #}
            {% if is_granted('dashboard.ver_totales') %}
            <section class="card p-5">
                <h2 class="section-title mb-4">Acumulado historico</h2>

                <div class="space-y-4">
                    <div>
                        <p class="field-label mb-1.5">Recaudado en cuotas</p>
                        {{ fmt.montos(cobrado, 'text-lg', 'text-emerald-600 dark:text-emerald-400') }}
                    </div>
                    <div class="border-t border-line pt-4">
                        <p class="field-label mb-1.5">Por cobrar</p>
                        {{ fmt.montos(pendiente, 'text-lg', 'text-red-600 dark:text-red-400') }}
                    </div>
                    <div class="border-t border-line pt-4">
                        <p class="field-label mb-1.5">Vendido</p>
                        {{ fmt.montos(totalVendido, 'text-lg') }}
                    </div>
                </div>

                <p class="hint mt-4">Pesos y dolares nunca se suman entre si.</p>
            </section>
            {% endif %}

            {# ---- Marcas ---- #}
            {% if topMarcas|length %}
                <section class="card p-5">
                    <h2 class="section-title mb-4">Marcas mas vendidas</h2>
                    {{ chart.ranking(topMarcas|map(m => {'etiqueta': m.name, 'valor': m.salesCount})) }}
                </section>
            {% endif %}

            {# ---- Vendedores ---- #}
            {% if vendedores|length %}
                <section class="card p-5">
                    <h2 class="section-title mb-4">Ventas por vendedor</h2>
                    {{ chart.ranking(vendedores|map(v => {'etiqueta': v.vendedor, 'valor': v.cantidad})) }}
                </section>
            {% endif %}

            {# ---- Ultimas ventas ---- #}
            <section class="card overflow-hidden">
                <div class="border-b border-line px-5 py-3">
                    <h2 class="text-sm font-semibold">Ultimas ventas</h2>
                </div>
                <ul class="divide-y divide-line">
                    {% for venta in ultimasVentas %}
                        <li>
                            <a href="{{ path('app_ventas_show', {'id': venta.id}) }}"
                               class="flex items-center justify-between gap-3 px-5 py-3 transition hover:bg-surface-2">
                                <div class="min-w-0">
                                    <p class="truncate text-sm font-medium">{{ venta.cliente.firstName }} {{ venta.cliente.lastName }}</p>
                                    <p class="mono mt-0.5 text-xs text-subtle">{{ venta.saleDate|date('d/m/Y') }}</p>
                                </div>
                                <span class="shrink-0 text-sm font-medium">
                                    {{ fmt.money(venta.finalSalePrice, venta.saleCurrency|default('ARS'), 0) }}
                                </span>
                            </a>
                        </li>
                    {% endfor %}
                </ul>
            </section>
        </div>
    </div>
{% endblock %}
