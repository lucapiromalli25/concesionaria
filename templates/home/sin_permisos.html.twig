{% extends 'layout.html.twig' %}
{% import 'partials/icons.html.twig' as icons %}

{% block title %}Sin permisos - Atilio Automotores{% endblock %}
{% block page_title %}Sin permisos asignados{% endblock %}

{% block body %}
    <div class="card mx-auto max-w-lg p-8 text-center">
        <span class="mx-auto mb-4 flex size-12 items-center justify-center rounded-full bg-surface-2 text-subtle">
            {{ icons.icon('shield', 'size-6') }}
        </span>
        <h2 class="text-base font-semibold">Tu usuario todavia no tiene un rol</h2>
        <p class="mt-2 text-sm text-muted">
            Entraste bien al sistema, pero no tenes ningun modulo habilitado.
            Pedile a un administrador que te asigne un rol.
        </p>
        <a href="{{ path('app_logout') }}" class="btn-secondary btn-sm mt-6">Cerrar sesion</a>
    </div>
{% endblock %}
