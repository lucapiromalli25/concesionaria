{% form_theme form 'form/tailwind_theme.html.twig' %}
{% set usuario = form.vars.value %}

{{ form_start(form, {
    'action': usuario.id ? path('app_user_edit', {'id': usuario.id}) : path('app_user_new'),
    'attr': {'novalidate': 'novalidate'}
}) }}
    {% if not form.vars.valid %}
        <div class="mx-5 mt-4 rounded-lg border border-red-200 bg-red-50 px-3 py-2 text-xs text-red-700 dark:border-red-400/25 dark:bg-red-500/10 dark:text-red-300">
            {{ form_errors(form) }}
            {% if form.vars.errors|length == 0 %}No se pudo guardar. Revisa los campos marcados.{% endif %}
        </div>
    {% endif %}
    <div class="space-y-4 px-5 py-4">
        {{ form_row(form.complete_name) }}
        <div class="grid grid-cols-2 gap-3">
            {{ form_row(form.dni, {'attr': {'inputmode': 'numeric'}}) }}
            {{ form_row(form.email) }}
        </div>
        {{ form_row(form.plainPassword) }}

        <div>
            {{ form_label(form.rolesAsignados) }}
            <div class="space-y-1.5 rounded-lg border border-line p-3">
                {% for rol in form.rolesAsignados %}
                    <label class="flex cursor-pointer items-start gap-2.5 text-sm">
                        {{ form_widget(rol, {'attr': {'class': 'mt-0.5 size-4 shrink-0 rounded border-line accent-[var(--app-accent)]'}}) }}
                        <span>
                            {{ rol.vars.label }}
                            {% if rol.vars.attr['data-descripcion'] %}
                                <span class="block text-xs text-subtle">{{ rol.vars.attr['data-descripcion'] }}</span>
                            {% endif %}
                        </span>
                    </label>
                {% endfor %}
            </div>
            {{ form_errors(form.rolesAsignados) }}
            <p class="hint mt-1.5">Lo que quede sin tildar se le quita al guardar.</p>
        </div>
    </div>

    <div class="modal-footer">
        <button type="button" data-action="remote-dialog#close" class="btn-secondary btn-sm">Cancelar</button>
        <button type="submit" class="btn-primary btn-sm">Guardar</button>
    </div>
{{ form_end(form) }}
