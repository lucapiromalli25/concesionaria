{% extends 'layout.html.twig' %}
{% import 'partials/icons.html.twig' as icons %}
{% import 'partials/table.html.twig' as tbl %}

{% block title %}Clientes - Atilio Automotores{% endblock %}
{% block page_title %}Clientes{% endblock %}
{% block page_subtitle %}
    <p class="text-xs text-muted">{{ total }} cliente{{ total == 1 ? '' : 's' }}</p>
{% endblock %}

{% block page_actions %}
    {% if is_granted('clientes.crear') %}
        <button type="button" class="btn-primary btn-sm"
                data-action="remote-dialog#open"
                data-dialog-url="{{ path('app_clientes_new') }}"
                data-dialog-title="Nuevo cliente">
            {{ icons.icon('plus', 'size-4') }}<span class="hidden sm:inline">Nuevo cliente</span>
        </button>
    {% endif %}
{% endblock %}

{% block body %}
<div>
    <turbo-frame id="clientes" data-turbo-action="advance" class="block">
        <div class="card overflow-hidden">

            <form method="get" action="{{ path('app_clientes_index') }}"
                  data-controller="filter-form" data-action="input->filter-form#submit"
                  class="flex flex-wrap items-end gap-3 border-b border-line bg-surface-2 p-4">
                <div class="relative min-w-64 flex-1">
                    <span class="pointer-events-none absolute inset-y-0 left-3 flex items-center text-subtle">
                        {{ icons.icon('search', 'size-4') }}
                    </span>
                    <input type="search" name="q" value="{{ q }}" autocomplete="off"
                           placeholder="Buscar por nombre, apellido, DNI o telefono" class="input pl-9">
                </div>
                <input type="hidden" name="sort" value="{{ sort }}">
                <input type="hidden" name="dir" value="{{ dir }}">
                <noscript><button type="submit" class="btn-primary">Buscar</button></noscript>
                {% if q %}
                    <a href="{{ path('app_clientes_index') }}" class="btn-ghost btn-sm">{{ icons.icon('x', 'size-4') }} Limpiar</a>
                {% endif %}
            </form>

            <div class="table-wrap">
                <table class="table">
                    <thead>
                        <tr>
                            {{ tbl.sortable('Cliente', 'apellido', sort, dir, 'app_clientes_index') }}
                            {{ tbl.sortable('Documento', 'documento', sort, dir, 'app_clientes_index') }}
                            <th>Telefono</th>
                            <th>Domicilio</th>
                            <th class="text-right">Operaciones</th>
                            <th class="text-right">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                    {% for fila in filas %}
                        {% set cliente = fila[0] %}
                        <tr>
                            <td class="font-medium">{{ cliente.firstName }} {{ cliente.lastName }}</td>
                            <td class="mono">{{ cliente.documentNumber }}</td>
                            <td class="mono text-muted">{{ cliente.phone|default('-') }}</td>
                            <td class="max-w-xs truncate text-muted" title="{{ cliente.address }}">
                                {{ cliente.address|default('-') }}
                            </td>
                            <td class="text-right">
                                <div class="flex items-center justify-end gap-1.5">
                                    {% if fila.ventas > 0 %}
                                        <a href="{{ path('app_ventas_index', {'q': cliente.documentNumber}) }}"
                                           class="badge-green" data-turbo="false">{{ fila.ventas }} venta{{ fila.ventas == 1 ? '' : 's' }}</a>
                                    {% endif %}
                                    {% if fila.reservas > 0 %}
                                        <span class="badge-sky">{{ fila.reservas }} reserva{{ fila.reservas == 1 ? '' : 's' }}</span>
                                    {% endif %}
                                    {% if fila.ventas == 0 and fila.reservas == 0 %}
                                        <span class="text-xs text-subtle">sin operaciones</span>
                                    {% endif %}
                                </div>
                            </td>
                            <td>
                                <div class="flex items-center justify-end gap-1">
                                    {% if is_granted('clientes.editar') %}
                                        <button type="button" class="btn-ghost btn-sm" title="Editar"
                                                data-action="remote-dialog#open"
                                                data-dialog-url="{{ path('app_clientes_edit', {'id': cliente.id}) }}"
                                                data-dialog-title="Editar cliente">
                                            {{ icons.icon('pencil', 'size-4') }}
                                        </button>
                                    {% endif %}
                                </div>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="6" class="py-16 text-center">
                                <div class="mx-auto flex max-w-sm flex-col items-center gap-2 text-subtle">
                                    {{ icons.icon('users', 'size-8') }}
                                    <p class="text-sm font-medium text-muted">No se encontraron clientes</p>
                                </div>
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>

            {% if total > 0 %}
                <div class="flex flex-wrap items-center justify-between gap-3 border-t border-line bg-surface-2 px-4 py-3">
                    <p class="text-xs text-muted">
                        Mostrando <span class="font-medium text-fg">{{ (currentPage - 1) * 25 + 1 }}-{{ min(currentPage * 25, total) }}</span>
                        de <span class="font-medium text-fg">{{ total }}</span>
                    </p>
                    <div class="flex items-center gap-1">
                        <a href="{{ path('app_clientes_index', app.request.query.all|merge({'page': currentPage - 1})) }}"
                           class="btn-ghost btn-sm {{ currentPage == 1 ? 'pointer-events-none opacity-40' : '' }}">
                            {{ icons.icon('chevron-left', 'size-4') }}
                        </a>
                        {% for p in 1..totalPages %}
                            {% if p == 1 or p == totalPages or (p >= currentPage - 1 and p <= currentPage + 1) %}
                                <a href="{{ path('app_clientes_index', app.request.query.all|merge({'page': p})) }}"
                                   class="btn-sm {{ p == currentPage ? 'btn-primary' : 'btn-ghost' }} min-w-8">{{ p }}</a>
                            {% elseif p == 2 or p == totalPages - 1 %}
                                <span class="px-1 text-subtle">...</span>
                            {% endif %}
                        {% endfor %}
                        <a href="{{ path('app_clientes_index', app.request.query.all|merge({'page': currentPage + 1})) }}"
                           class="btn-ghost btn-sm {{ currentPage == totalPages ? 'pointer-events-none opacity-40' : '' }}">
                            {{ icons.icon('chevron-right', 'size-4') }}
                        </a>
                    </div>
                </div>
            {% endif %}
        </div>
    </turbo-frame>

    <dialog data-remote-dialog-target="dialog" class="modal max-w-lg">
        <div class="modal-header flex items-center justify-between">
            <h3 class="font-semibold" data-remote-dialog-target="title"></h3>
            <button type="button" data-action="remote-dialog#close" class="btn-ghost btn-icon">
                {{ icons.icon('x', 'size-4') }}
            </button>
        </div>
        <div data-remote-dialog-target="content"></div>
    </dialog>
</div>
{% endblock %}
